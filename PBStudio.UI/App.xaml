<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="PBStudio.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:PBStudio.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ableton-inspired: Dark base, DeepOrange primary, Amber secondary -->
                <md:BundledTheme BaseTheme="Dark" PrimaryColor="DeepOrange" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Konverter -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <conv:ConfidenceToBrushConverter x:Key="ConfidenceToBrushConverter"/>

            <!-- ══════ Ableton-Palette (Colors, fuer Storyboards/Animationen) ══════ -->
            <Color x:Key="AbletonBgColor">#1A1A1E</Color>
            <Color x:Key="AbletonPanelColor">#232326</Color>
            <Color x:Key="AbletonSurfaceColor">#2D2D31</Color>
            <Color x:Key="AbletonBorderColor">#3A3A3F</Color>
            <Color x:Key="AbletonAccentColor">#FF764D</Color>
            <Color x:Key="AbletonAccentDimColor">#CC5E3D</Color>
            <Color x:Key="AbletonTextColor">#D4D4D8</Color>
            <Color x:Key="AbletonTextDimColor">#8A8A90</Color>
            <Color x:Key="AbletonGreenColor">#87C96B</Color>
            <Color x:Key="AbletonYellowColor">#E5C07B</Color>
            <Color x:Key="AbletonRedColor">#E06C75</Color>
            <Color x:Key="AbletonBlueColor">#61AFEF</Color>

            <!-- ══════ Ableton-Palette (Brushes) ══════ -->
            <SolidColorBrush x:Key="AbletonBg"          Color="{StaticResource AbletonBgColor}"/>
            <SolidColorBrush x:Key="AbletonPanel"       Color="{StaticResource AbletonPanelColor}"/>
            <SolidColorBrush x:Key="AbletonSurface"     Color="{StaticResource AbletonSurfaceColor}"/>
            <SolidColorBrush x:Key="AbletonBorder"      Color="{StaticResource AbletonBorderColor}"/>
            <SolidColorBrush x:Key="AbletonAccent"      Color="{StaticResource AbletonAccentColor}"/>
            <SolidColorBrush x:Key="AbletonAccentDim"   Color="{StaticResource AbletonAccentDimColor}"/>
            <SolidColorBrush x:Key="AbletonText"        Color="{StaticResource AbletonTextColor}"/>
            <SolidColorBrush x:Key="AbletonTextDim"     Color="{StaticResource AbletonTextDimColor}"/>
            <SolidColorBrush x:Key="AbletonGreen"       Color="{StaticResource AbletonGreenColor}"/>
            <SolidColorBrush x:Key="AbletonYellow"      Color="{StaticResource AbletonYellowColor}"/>
            <SolidColorBrush x:Key="AbletonRed"         Color="{StaticResource AbletonRedColor}"/>
            <SolidColorBrush x:Key="AbletonBlue"        Color="{StaticResource AbletonBlueColor}"/>

            <!-- ══════ Global Overrides ══════ -->
            <!-- Flat card style (no elevation, sharp corners) -->
            <Style x:Key="AbletonCard" TargetType="md:Card">
                <Setter Property="Background" Value="{StaticResource AbletonSurface}"/>
                <Setter Property="UniformCornerRadius" Value="2"/>
                <Setter Property="md:ElevationAssist.Elevation" Value="Dp0"/>
                <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Section header text -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Compact label -->
            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

            <!-- Value display -->
            <Style x:Key="ParamValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            </Style>

            <!-- ══════ Toolbar Styles ══════ -->
            <Style x:Key="AbletonToolbar" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AbletonPanel}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Padding" Value="4,2"/>
            </Style>

            <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Video-Thumbnail-Card im Grid (VideoLibraryView). Wieder global definiert, nachdem
                 commit 6dbf895 die lokalen Styles entfernt hatte ohne sie nach App.xaml zu migrieren. -->
            <Style x:Key="VideoThumbCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AbletonSurface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="Margin" Value="4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
