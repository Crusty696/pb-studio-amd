<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="PBStudio.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:PBStudio.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ableton-inspired: Dark base, DeepOrange primary, Amber secondary -->
                <md:BundledTheme BaseTheme="Dark" PrimaryColor="DeepOrange" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Konverter -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

            <!-- ══════ Ableton-Palette (custom brushes) ══════ -->
            <SolidColorBrush x:Key="AbletonBg"          Color="#1A1A1E"/>
            <SolidColorBrush x:Key="AbletonPanel"       Color="#232326"/>
            <SolidColorBrush x:Key="AbletonSurface"     Color="#2D2D31"/>
            <SolidColorBrush x:Key="AbletonBorder"      Color="#3A3A3F"/>
            <SolidColorBrush x:Key="AbletonAccent"      Color="#FF764D"/>
            <SolidColorBrush x:Key="AbletonAccentDim"   Color="#CC5E3D"/>
            <SolidColorBrush x:Key="AbletonText"        Color="#D4D4D8"/>
            <SolidColorBrush x:Key="AbletonTextDim"     Color="#8A8A90"/>
            <SolidColorBrush x:Key="AbletonGreen"       Color="#87C96B"/>
            <SolidColorBrush x:Key="AbletonYellow"      Color="#E5C07B"/>
            <SolidColorBrush x:Key="AbletonRed"         Color="#E06C75"/>
            <SolidColorBrush x:Key="AbletonBlue"        Color="#61AFEF"/>

            <!-- ══════ Global Overrides ══════ -->
            <!-- Flat card style (no elevation, sharp corners) -->
            <Style x:Key="AbletonCard" TargetType="md:Card">
                <Setter Property="Background" Value="{StaticResource AbletonSurface}"/>
                <Setter Property="UniformCornerRadius" Value="2"/>
                <Setter Property="md:ElevationAssist.Elevation" Value="Dp0"/>
                <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Section header text -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Compact label -->
            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

            <!-- Value display -->
            <Style x:Key="ParamValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
