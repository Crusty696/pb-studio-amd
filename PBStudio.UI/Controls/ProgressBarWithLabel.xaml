<UserControl x:Class="PBStudio.UI.Controls.ProgressBarWithLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PBStudio.UI.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Height="22">
        <ProgressBar x:Name="Pb"
                     Minimum="0" Maximum="100"
                     Value="{Binding Percent, ElementName=Root}"
                     IsIndeterminate="{Binding IsIndeterminate, ElementName=Root}"
                     Foreground="{StaticResource AbletonAccent}"
                     Background="{StaticResource AbletonBorder}"
                     BorderThickness="0"
                     SmallChange="0.01"
                     LargeChange="1.0"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource AbletonText}"
                   Text="{Binding LabelText, ElementName=Root}"/>
    </Grid>
</UserControl>
