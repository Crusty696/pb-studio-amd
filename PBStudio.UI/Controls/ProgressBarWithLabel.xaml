<UserControl x:Class="PBStudio.UI.Controls.ProgressBarWithLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Stretch">
    <!-- Verdoppelte Hoehe + grosse Schrift damit % sichtbar (User-Feedback iteriert).
         HorizontalAlignment Stretch im Container damit Bar volle Breite nutzt. -->
    <Grid Height="56" MinWidth="200">
        <!-- 1. Background Rounded Border (immer da, sehr dunkel) -->
        <Border Background="#0A0A0D" BorderBrush="{StaticResource AbletonAccent}"
                BorderThickness="2" CornerRadius="8"/>
        <!-- 2. Progress Bar Foreground (orange Fuellung von links nach rechts) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Background="{StaticResource AbletonAccent}" CornerRadius="6,0,0,6"
                Margin="3,3,0,3"
                Width="{Binding FillWidth, ElementName=Root}"/>
        <!-- 3. Indeterminate fallback (animated) -->
        <ProgressBar IsIndeterminate="{Binding IsIndeterminate, ElementName=Root}"
                     Background="Transparent" Foreground="{StaticResource AbletonAccent}"
                     BorderThickness="0" Margin="3" Opacity="0.7">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <!-- 4. % Label (IMMER sichtbar, gross, weiss + dunkler Schatten) -->
        <Grid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="26" FontWeight="Bold"
                       Foreground="Black" Opacity="0.9"
                       Margin="2,2,0,0"
                       Text="{Binding LabelText, ElementName=Root}"/>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="26" FontWeight="Bold"
                       Foreground="White"
                       Text="{Binding LabelText, ElementName=Root}"/>
        </Grid>
    </Grid>
</UserControl>
