<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PBStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
        xmlns:views="clr-namespace:PBStudio.UI.Views"
        xmlns:converters="clr-namespace:PBStudio.UI.Converters"
        xmlns:controls="clr-namespace:PBStudio.UI.Controls"
        mc:Ignorable="d"
        Title="PB Studio AMD"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AbletonBg}"
        Style="{StaticResource MaterialDesignWindow}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <md:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Top Header ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource AbletonPanel}"
                    BorderBrush="{StaticResource AbletonBorder}"
                    BorderThickness="0,0,0,1">
                <DockPanel Height="36">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="PB STUDIO" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AbletonTextDim}"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource AbletonTextDim}"/>
                        <TextBlock Text="{Binding CurrentProjectName}" FontSize="11" Foreground="{StaticResource AbletonAccent}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <icon:PackIconMaterial Kind="Memory" Width="12" Height="12" VerticalAlignment="Center" Foreground="{StaticResource AbletonTextDim}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding GpuStatusText}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AbletonTextDim}"/>
                        </StackPanel>
                        <Ellipse Width="7" Height="7" Fill="{Binding BackendStatusColor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding BackendStatusText}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AbletonTextDim}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Main Tabs Area ── -->
            <controls:CachedTabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="{StaticResource AbletonBg}" BorderThickness="0"
                        RenderTransformOrigin="0.5,0.05" Opacity="1.0">
                <controls:CachedTabControl.RenderTransform>
                    <!-- P2.1/Spec-00007 T010: GPU-accelerated tab swap animation.
                         ScaleTransform animiert ueber Compositor-Thread (RenderTransform = GPU-Pfad). -->
                    <ScaleTransform x:Name="TabContentScale" ScaleX="1.0" ScaleY="1.0"/>
                </controls:CachedTabControl.RenderTransform>
                <controls:CachedTabControl.Triggers>
                    <EventTrigger RoutedEvent="Selector.SelectionChanged">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TabContentScale" Storyboard.TargetProperty="ScaleX"
                                                 From="0.97" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="TabContentScale" Storyboard.TargetProperty="ScaleY"
                                                 From="0.97" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.6" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </controls:CachedTabControl.Triggers>
                <controls:CachedTabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <!-- Tab-Header Farbe (User-Wunsch 2026-05-09):
                             aktiv = Accent-Orange (#FF764D), inaktiv = TextDim (#8A8A90),
                             Hover = AbletonText (#D4D4D8). Ersetzt das Default-MaterialDesign-Weiss/Grau
                             auf dunklem AbletonBg, das schwer lesbar war. -->
                        <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                        <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                                          Margin="{TemplateBinding Padding}"
                                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AbletonAccent}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </controls:CachedTabControl.Resources>

                <TabItem Header="PROJEKT">
                    <views:ProjectOverviewView/>
                </TabItem>
                <TabItem Header="AUDIO">
                    <views:AudioLibraryView/>
                </TabItem>
                <TabItem Header="VIDEO">
                    <views:VideoLibraryView/>
                </TabItem>
                <TabItem Header="KI-REGIE">
                    <views:DirectorView/>
                </TabItem>
                <TabItem Header="TIMELINE">
                    <views:TimelineView/>
                </TabItem>
                <TabItem Header="EXPORT">
                    <views:ProductionView/>
                </TabItem>
                <TabItem Header="HIRN">
                    <views:BrainView/>
                </TabItem>
                <TabItem Header="SETTINGS">
                    <views:SettingsView/>
                </TabItem>
                <TabItem Header="PERFORMANCE">
                    <views:VramTelemetryView/>
                </TabItem>
                <!-- Index 9: MODELLE (Ollama-Pilot Phase 4) — bewusst AM ENDE angehaengt,
                     damit SelectedTabIndex=3 (KI-REGIE) als Default-Tab unangetastet bleibt
                     (siehe MainViewModel.cs Zeile 76 + NavigateDirectorMessage-Handler). -->
                <TabItem Header="MODELLE">
                    <views:ModelManagerView/>
                </TabItem>
                <!-- Index 10: KI-CHAT (Ollama Tool-Use Track 2026-05-16) — auch am ENDE,
                     damit SelectedTabIndex=3 (KI-REGIE) unverletzt bleibt. -->
                <TabItem Header="CHAT">
                    <views:ChatView/>
                </TabItem>
                <TabItem Header="TERMINAL">
                    <views:TerminalView/>
                </TabItem>
            </controls:CachedTabControl>

            <!-- ── Status Bar ── -->
            <Border Grid.Row="2" Height="24" Background="{StaticResource AbletonPanel}" BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" Margin="10,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource AbletonTextDim}"/>
            </Border>

            <!-- ── Spec 00010 T004: ConnectionStatus Overlay ──
                 Sichtbar nur wenn SSE >=5 Reconnect-Versuche fehlgeschlagen sind.
                 Auto-Hide auf erfolgreichen Reconnect. Non-modal, Top-Banner.
                 Visibility bindet an MainViewModel.IsBackendUnreachable. -->
            <Border Grid.Row="1" VerticalAlignment="Top"
                    Height="36"
                    Background="#FF8B1A1A" BorderBrush="#FF5A0F0F" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsBackendUnreachable, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="1000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <icon:PackIconMaterial Kind="WifiOff" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Verbindung zum Backend verloren — versuche erneut..."
                               Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </md:DialogHost>
</Window>
