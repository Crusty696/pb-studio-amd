<UserControl x:Class="PBStudio.UI.Views.AnchorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left: Audio Timeline ══ -->
        <md:Card Grid.Column="0" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="AUDIO TIMELINE"
                           Style="{StaticResource SectionHeader}"/>

                <!-- Position Controls -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Slider Value="{Binding CurrentPosition}" Minimum="0" Maximum="300"
                            TickFrequency="1" IsSnapToTickEnabled="False"
                            Foreground="{StaticResource AbletonAccent}"
                            ToolTip="Position im Audio-Track (Sekunden)"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{StaticResource AbletonTextDim}" FontSize="12">
                        <Run Text="Position: "/><Run Text="{Binding CurrentPosition, StringFormat={}{0:F2}, Mode=OneWay}"/><Run Text=" s"/>
                    </TextBlock>
                </StackPanel>

                <!-- Waveform Placeholder -->
                <Border Background="#1A1A2E" CornerRadius="2" Margin="0,8,0,0"
                        BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1">
                    <Grid MinHeight="180">
                        <!-- Fake waveform lines -->
                        <Canvas ClipToBounds="True" Opacity="0.3">
                            <Line X1="0" Y1="90" X2="9999" Y2="90" Stroke="{StaticResource AbletonAccent}"
                                  StrokeThickness="0.5" StrokeDashArray="4,4"/>
                        </Canvas>
                        <TextBlock Text="WAVEFORM" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource AbletonTextDim}"
                                   FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                    </Grid>
                </Border>
            </DockPanel>
        </md:Card>

        <!-- ══ Right: Anchor List ══ -->
        <md:Card Grid.Column="1" Style="{StaticResource AbletonCard}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ANCHOR-PUNKTE"
                           Style="{StaticResource SectionHeader}"/>

                <!-- Add / Remove Buttons -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding AddAnchorCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            ToolTip="Anchor-Punkt an aktueller Position setzen"
                            Padding="6,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Plus" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Hinzufügen" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveAnchorCommand}"
                            CommandParameter="{Binding SelectedAnchor}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonRed}"
                            ToolTip="Anchor-Punkt entfernen"
                            Padding="6,4" Height="30" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Delete" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Entfernen" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,6,0,0"
                           Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>

                <!-- Anchor ListView -->
                <ListView ItemsSource="{Binding Anchors}" SelectedItem="{Binding SelectedAnchor}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource AbletonText}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="{StaticResource AbletonPanel}"/>
                            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Zeit" Width="75">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas"
                                                   FontSize="12" Foreground="{StaticResource AbletonGreen}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Label" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   Foreground="{StaticResource AbletonText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </md:Card>
    </Grid>
</UserControl>