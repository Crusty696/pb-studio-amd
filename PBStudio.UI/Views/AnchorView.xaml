<UserControl x:Class="PBStudio.UI.Views.AnchorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}"
             AutomationProperties.Name="Anchor-Punkte"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadWaveformCommand}"/>
        <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding AddAnchorCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left: Audio Timeline ══ -->
        <md:Card Grid.Column="0" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,8,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="AUDIO TIMELINE"
                               Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ComboBox Width="280"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding AvailableAudioClips}"
                                  SelectedItem="{Binding SelectedAudioClip}"
                                  DisplayMemberPath="Name"
                                  Background="{StaticResource AbletonSurface}"
                                  Foreground="{StaticResource AbletonText}"
                                  BorderBrush="{StaticResource AbletonBorder}"
                                  FontSize="12"
                                  AutomationProperties.Name="Audio-Quelle"
                                  AutomationProperties.HelpText="Wählt den Audio-Clip für Waveform, Beat-Marker und Anchor-Punkte."
                                  ToolTip="Audio-Quelle für Waveform und Beat-Marker"/>
                        <Button Command="{Binding ReloadWaveformCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource AbletonAccent}"
                                ToolTip="Waveform und Beat-Marker neu laden"
                                Padding="6,4" Height="30"
                                AutomationProperties.Name="Waveform neu laden"
                                AutomationProperties.HelpText="Lädt Waveform und Beat-Marker der gewählten Audio-Quelle neu."
                                AutomationProperties.AcceleratorKey="F5">
                            <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Position Controls -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Slider Value="{Binding CurrentPosition}"
                            Minimum="0"
                            Maximum="{Binding TimelineDuration}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="False"
                            Foreground="{StaticResource AbletonAccent}"
                            AutomationProperties.Name="Audio-Position"
                            AutomationProperties.HelpText="Verschiebt die aktuelle Position in Sekunden; Pfeiltasten ändern den Wert."
                            ToolTip="Position im Audio-Track (Sekunden)"/>
                    <DockPanel Margin="0,4,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Foreground="{StaticResource AbletonTextDim}" FontSize="12">
                            <Run Text="Position: "/><Run Text="{Binding CurrentPosition, StringFormat={}{0:F2}, Mode=OneWay}"/><Run Text=" s"/>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource AbletonTextDim}" FontSize="12">
                            <Run Text="Dauer: "/><Run Text="{Binding TimelineDuration, StringFormat={}{0:F2}}"/><Run Text=" s"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>

                <!-- Real Waveform Surface -->
                <Border CornerRadius="2" Margin="0,8,0,0"
                        BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#1A1A2E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid MinHeight="180" Width="720" HorizontalAlignment="Stretch">
                        <Canvas Width="720" Height="180" ClipToBounds="True">
                            <!-- Midline -->
                            <Line X1="0" Y1="90" X2="720" Y2="90"
                                  Stroke="{StaticResource AbletonBorder}"
                                  StrokeThickness="1"
                                  StrokeDashArray="4,4"/>

                            <!-- Waveform bars -->
                            <ItemsControl ItemsSource="{Binding WaveformBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="720" Height="180"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}"
                                                   Height="{Binding Height}"
                                                   RadiusX="1" RadiusY="1"
                                                   Fill="{StaticResource AbletonAccent}"
                                                   Opacity="0.75"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Beat markers -->
                            <ItemsControl ItemsSource="{Binding BeatMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="720" Height="180"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="1.5" Height="180"
                                                Background="{StaticResource AbletonYellow}"
                                                Opacity="0.55"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Current position marker -->
                            <Border Width="2" Height="180"
                                    Background="{StaticResource AbletonGreen}"
                                    Canvas.Left="{Binding PositionMarkerX}"
                                    Canvas.Top="0"/>
                        </Canvas>

                        <Grid Visibility="{Binding IsLoadingWaveform, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Background="#66000000">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="140" Height="4"
                                             Foreground="{StaticResource AbletonAccent}"/>
                                <TextBlock Text="Waveform wird geladen..."
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource AbletonTextDim}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </DockPanel>
        </md:Card>

        <!-- ══ Right: Anchor List ══ -->
        <md:Card Grid.Column="1" Style="{StaticResource AbletonCard}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ANCHOR-PUNKTE"
                           Style="{StaticResource SectionHeader}"/>

                <!-- Add / Remove Buttons -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding AddAnchorCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            ToolTip="Anchor-Punkt an aktueller Position setzen"
                            Padding="6,4" Height="30"
                            AutomationProperties.Name="Anchor-Punkt hinzufügen"
                            AutomationProperties.HelpText="Setzt einen neuen Anchor-Punkt an der aktuellen Audio-Position."
                            AutomationProperties.AcceleratorKey="Strg+Umschalt+A">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Plus" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Hinzufügen" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveAnchorCommand}"
                            CommandParameter="{Binding SelectedAnchor}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonRed}"
                            ToolTip="Anchor-Punkt entfernen"
                            Padding="6,4" Height="30" Margin="4,0,0,0"
                            AutomationProperties.Name="Ausgewählten Anchor-Punkt entfernen"
                            AutomationProperties.HelpText="Entfernt nach Aktivierung dieser Schaltfläche den ausgewählten Anchor-Punkt. Dieser Vorgang kann nicht rückgängig gemacht werden.">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Delete" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Entfernen" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,6,0,0"
                           Foreground="{StaticResource AbletonTextDim}" FontSize="11" TextWrapping="Wrap"/>

                <!-- Anchor ListView -->
                <ListView ItemsSource="{Binding Anchors}" SelectedItem="{Binding SelectedAnchor}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource AbletonText}"
                          AutomationProperties.Name="Anchor-Punkt-Liste"
                          AutomationProperties.HelpText="Liste aller Anchor-Punkte. Auswahl mit Pfeiltasten ändern; zum Löschen anschließend die Schaltfläche Ausgewählten Anchor-Punkt entfernen aktivieren.">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="{StaticResource AbletonPanel}"/>
                            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Zeit" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas"
                                                   FontSize="12" Foreground="{StaticResource AbletonGreen}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Label" Width="135">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   Foreground="{StaticResource AbletonText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </md:Card>
    </Grid>
</UserControl>
