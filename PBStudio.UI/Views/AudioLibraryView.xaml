<UserControl x:Class="PBStudio.UI.Views.AudioLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:controls="clr-namespace:PBStudio.UI.Controls"
             Background="{StaticResource AbletonBg}"
             AutomationProperties.Name="Audio-Bibliothek"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.InputBindings>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportAudioCommand}"/>
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding ImportFolderCommand}"/>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="Delete" Modifiers="Control+Shift" Command="{Binding DeleteAllCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AnalyzeSelectedCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Flat compact button for batch actions -->
        <Style x:Key="BatchBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action button (accent outline) -->
        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AbletonAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Metric card -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AbletonSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- List item style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#28FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30FF764D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left Panel: Audio List ══ -->
        <md:Card Grid.Column="0" Style="{StaticResource AbletonCard}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="AUDIO-CLIPS"
                           Style="{StaticResource SectionHeader}"/>

                <!-- Batch actions (WrapPanel damit Delete-Buttons in schmaler Spalte sichtbar) -->
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding ImportAudioCommand}" Style="{StaticResource BatchBtn}"
                             ToolTip="Dateien importieren&#x0a;• Was es macht: Importiert Musikdateien (WAV, MP3, FLAC) in das Projekt.&#x0a;• Wozu es dient: Bildet das rhythmische Fundament (Beatgrid, BPM) für Ihr Video.&#x0a;• Wann nutzen: Vor der Videoerstellung, um den Song für das Projekt festzulegen."
                             Foreground="{StaticResource AbletonAccent}"
                             AutomationProperties.Name="Audio-Dateien importieren"
                             AutomationProperties.HelpText="Importiert ausgewählte WAV-, MP3- oder FLAC-Dateien in das aktive Projekt."
                             AutomationProperties.AcceleratorKey="Strg+I">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Plus" Width="12" Height="12"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dateien" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportFolderCommand}" Style="{StaticResource BatchBtn}"
                             ToolTip="Ordner importieren&#x0a;• Was es macht: Importiert einen kompletten Musikordner auf einmal.&#x0a;• Wozu es dient: Erlaubt das schnelle Befüllen der Bibliothek mit vielen Songs.&#x0a;• Wann nutzen: Nützlich zum Batch-Einlesen Ihrer gesamten Mix- oder Sound-Bibliothek."
                             Foreground="{StaticResource AbletonAccent}" Margin="2,0,0,0"
                             AutomationProperties.Name="Audio-Ordner importieren"
                             AutomationProperties.HelpText="Importiert unterstützte Audio-Dateien aus einem ausgewählten Ordner."
                             AutomationProperties.AcceleratorKey="Strg+Umschalt+I">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="FolderPlus" Width="12" Height="12"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ordner" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,4"/>
                    <Button Command="{Binding SelectAllCommand}" Style="{StaticResource BatchBtn}"
                            Content="_Alle markieren"
                            AutomationProperties.Name="Alle Audio-Clips markieren"
                            AutomationProperties.AcceleratorKey="Strg+A"/>
                    <Button Command="{Binding DeselectAllCommand}" Style="{StaticResource BatchBtn}"
                            Content="_Keine" Margin="2,0"
                            AutomationProperties.Name="Audio-Auswahl aufheben"/>
                    <!-- Audit 2026-08-05 (H-1/T3b.2): IsDeleting war an kein
                         XAML-Element gebunden. Der User klickte "Loeschen" und
                         bekam bis zum Ende der Batch-Operation keinerlei
                         Rueckmeldung — genau das Symptom "Buttons reagieren
                         nicht". Gleiche Klasse wie BrainViewModel-StatusText
                         und Timeline-StatusText im CHANGELOG. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                Visibility="{Binding IsDeleting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <icon:PackIconMaterial Kind="Loading" Width="12" Height="12"
                                               VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{StaticResource AbletonAccent}"/>
                        <TextBlock Text="Loesche..." VerticalAlignment="Center"
                                   Foreground="{StaticResource AbletonAccent}"/>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,4"/>
                    <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource BatchBtn}"
                             ToolTip="Markierte Clips löschen&#x0a;• Was es macht: Entfernt die selektierten Songs vollständig aus der Projektdatenbank.&#x0a;• Wozu es dient: Bereinigt die Audiobibliothek. Die Originaldateien auf Ihrer Festplatte bleiben unangetastet.&#x0a;• Wann nutzen: Zum Entfernen nicht mehr benötigter Songs aus dem Projekt."
                             AutomationProperties.Name="Markierte Audio-Clips löschen"
                             AutomationProperties.HelpText="Entfernt alle markierten Audio-Clips aus dem Projekt; Originaldateien bleiben erhalten."
                             AutomationProperties.AcceleratorKey="Entfernen">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteOutline" Width="12" Height="12"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Markierte loeschen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteAllCommand}" Style="{StaticResource BatchBtn}"
                             ToolTip="Gesamte Bibliothek löschen&#x0a;• Was es macht: Leert die gesamte Audiodatenbank dieses Projekts unwiderruflich.&#x0a;• Wozu es dient: Setzt die Audio-Sektion des Projekts komplett zurück.&#x0a;• Wann nutzen: Nur nutzen, wenn Sie alle importierten Songs auf einmal entfernen möchten." Margin="2,0"
                             AutomationProperties.Name="Alle Audio-Clips löschen"
                             AutomationProperties.HelpText="Leert die Audio-Bibliothek des aktiven Projekts vollständig; Originaldateien bleiben erhalten."
                             AutomationProperties.AcceleratorKey="Strg+Umschalt+Entfernen">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweep" Width="12" Height="12"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AbletonRed}"/>
                            <TextBlock Text="Alle loeschen" VerticalAlignment="Center"
                                       Foreground="{StaticResource AbletonRed}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,4"/>
                    <Button Command="{Binding AnalyzeAllCommand}" Style="{StaticResource BatchBtn}"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}"
                            AutomationProperties.Name="Alle Audio-Clips analysieren"
                            AutomationProperties.HelpText="Analysiert alle Audio-Clips, für die noch keine vollständigen Ergebnisse vorliegen.">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlaylistCheck" Width="12" Height="12"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Alle analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Clip list (Multi-Select fuer Delete-Operationen) -->
                <!-- L-N2: Custom ItemTemplate mit CACHED-Badge wenn AudioHash vorhanden. -->
                <ListBox x:Name="AudioClipList"
                         ItemsSource="{Binding AudioClips}"
                         SelectedItem="{Binding SelectedClip}"
                         SelectionMode="Extended"
                         SelectionChanged="AudioClipList_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Audio-Clip-Liste"
                         AutomationProperties.HelpText="Mehrfachauswahl mit Umschalt- oder Strg-Taste; Entfernen löscht markierte Einträge aus dem Projekt.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="Auto"/>
                                     <ColumnDefinition Width="Auto"/>
                                     <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1"
                                        Background="#B7791F"
                                        CornerRadius="2"
                                        Padding="4,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasAnalysisIssue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="Analyse ist nicht vollständig; Details stehen im kopierbaren Statusfeld.">
                                    <TextBlock Text="{Binding AnalysisStatusText}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                                <!-- L-N2: CACHED-Badge — sichtbar wenn AudioHash gesetzt. -->
                                <Border Grid.Column="2"
                                        Background="{StaticResource AbletonAccent}"
                                        CornerRadius="2"
                                        Padding="4,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasCacheHash, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         ToolTip="Analyse-Cache verfügbar&#x0a;• Was es macht: Zeigt an, dass dieser Song bereits früher gehasht und erfolgreich analysiert wurde.&#x0a;• Wozu es dient: Überspringt die Beat-Analyse und lädt alle BPM- und Key-Daten in Millisekunden aus dem Cache.&#x0a;• Wann nutzen: Wird vollautomatisch beim erneuten Importieren bekannter Audiodateien angewendet.">
                                    <TextBlock Text="CACHED"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AbletonBg}"/>
                                </Border>
                                <!-- L-N4: STEMS-Badge — sichtbar wenn StemsPaths gesetzt. -->
                                <Border Grid.Column="3"
                                        Background="#22A06B"
                                        CornerRadius="2"
                                        Padding="4,1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasStems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         ToolTip="Stems vorhanden&#x0a;• Was es macht: Signalisiert, dass für diesen Song bereits erfolgreich eine Demucs Stem-Separation durchgeführt wurde.&#x0a;• Wozu es dient: Bestätigt, dass Sie nun das Stem-basierte Pacing im Director-Dashboard aktivieren können.&#x0a;• Wann nutzen: Informativ, um zu sehen, für welche Songs die Spuren bereits getrennt vorliegen.">
                                    <TextBlock Text="STEMS"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </md:Card>

        <!-- ══ Right Panel: Analysis ══ -->
        <DockPanel Grid.Column="2">

            <!-- Action buttons row -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Command="{Binding AnalyzeSelectedCommand}" Style="{StaticResource ActionBtn}"
                         IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}"
                         ToolTip="Audio-Clip analysieren&#x0a;• Was es macht: Führt eine mathematische Spektralanalyse auf der CPU durch (BPM, Tonart, Taktraster).&#x0a;• Wozu es dient: Erzeugt das Taktgitter (Beatgrid), auf dem später alle Videoschnitte exakt platziert werden.&#x0a;• Wann nutzen: Unbedingt vor dem Generieren einer Cut-Liste ausführen!" Margin="0,0,8,0"
                         AutomationProperties.Name="Ausgewählten Audio-Clip analysieren"
                         AutomationProperties.HelpText="Ermittelt BPM, Tonart, Beatgrid und Strukturdaten des ausgewählten Audio-Clips."
                         AutomationProperties.AcceleratorKey="Strg+Eingabe">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="Waveform" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analysieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SeparateStemsCommand}" Style="{StaticResource ActionBtn}"
                         IsEnabled="{Binding IsSeparating, Converter={StaticResource InverseBooleanConverter}}"
                         ToolTip="Stem-Separation (Demucs)&#x0a;• Was es macht: Teilt den ausgewählten Song mithilfe von KI in vier Spuren auf (Drums, Bass, Gesang, Sonstiges).&#x0a;• Wozu es dient: Ermöglicht das exakte Pacing (Cuts) auf einzelne Spuren wie z. B. nur Kicks oder Bässe.&#x0a;• Wann nutzen: Wenn Sie rhythmische Feinarbeit (Stem-basiertes Pacing) nutzen möchten. Der Prozess läuft intensiv auf der GPU."
                         AutomationProperties.Name="Stems des ausgewählten Audio-Clips trennen"
                         AutomationProperties.HelpText="Erzeugt getrennte Spuren für Drums, Bass, Gesang und Sonstiges.">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="TuneVertical" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Stems trennen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- L-N4: "Stems-Ordner oeffnen" — sichtbar wenn der ausgewaehlte Clip Stems hat. -->
                <Button Command="{Binding OpenStemsFolderCommand}"
                        CommandParameter="{Binding SelectedClip}"
                        Style="{StaticResource ActionBtn}"
                         Margin="8,0,0,0"
                         ToolTip="Stems-Ordner öffnen&#x0a;• Was es macht: Öffnet das lokale Verzeichnis mit den vier separierten Audiodateien im Windows Explorer.&#x0a;• Wozu es dient: Ermöglicht das Anhören oder Weiternutzen der exportierten Spuren in anderen Programmen.&#x0a;• Wann nutzen: Sobald die Stem-Separation erfolgreich abgeschlossen wurde und das 'STEMS'-Symbol am Song erscheint."
                         AutomationProperties.Name="Stems-Ordner öffnen"
                         AutomationProperties.HelpText="Öffnet den Ordner mit den erzeugten Stem-Dateien im Windows Explorer."
                         Visibility="{Binding SelectedClip.HasStems, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Stems-Ordner" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status-Bereich: Bar BREIT (full row), darunter Status-Text -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource AbletonPanel}"
                    BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1"
                    CornerRadius="2" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <!-- Import-Progress (full-width, sichtbar waehrend IsImporting) -->
                    <controls:ProgressBarWithLabel
                        Percent="{Binding ImportProgress}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                        Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- Audio-Analyse Progress (BPM/Key/Structure/Spectral - jede Phase volle Datei) -->
                    <controls:ProgressBarWithLabel
                        Percent="{Binding AnalysisProgress}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- Stem-Separation Progress -->
                    <controls:ProgressBarWithLabel
                        Percent="{Binding AnalysisProgress}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                        Visibility="{Binding IsSeparating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- Step-Indicator (nur sichtbar wenn IsAnalyzing UND CurrentStep gesetzt) -->
                    <StackPanel Orientation="Horizontal" Margin="2,4,0,0"
                                Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Schritt: " Foreground="{StaticResource AbletonTextDim}" FontSize="12"/>
                        <TextBlock Text="{Binding CurrentStep}" Foreground="{StaticResource AbletonAccent}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text=" " FontSize="12"/>
                        <TextBlock Text="{Binding AnalysisProgress, StringFormat={}{0:0.00} %}"
                                   Foreground="{StaticResource AbletonAccent}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBox Text="{Binding StatusText, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource AbletonTextDim}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             HorizontalAlignment="Stretch"
                             Margin="2,4,0,0"
                             AutomationProperties.Name="Audio-Status"
                             AutomationProperties.HelpText="Kopierbare Status- und Fehlermeldungen der Audio-Verarbeitung."
                             AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Section header -->
            <TextBlock DockPanel.Dock="Top" Text="ANALYSE-ERGEBNISSE"
                       Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

            <!-- Metric cards grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BPM -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="TEMPO" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource AbletonAccent}"
                                       Text="{Binding Bpm, StringFormat={}{0:F1}}"/>
                            <TextBlock Text=" BPM" FontSize="13"
                                       Foreground="{StaticResource AbletonTextDim}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </StackPanel>
                        <!-- Beatgrid als Regel (Anker + Tempo). Steht bewusst
                             NEBEN der BPM-Anzeige und ersetzt sie nicht: die
                             eigene Schaetzung trifft das Tempo in 48,8 % der
                             Faelle gegen 37,0 % des bisherigen Pfads - besser,
                             aber nicht gut genug, um allein zu stehen. -->
                        <TextBlock Text="{Binding BeatGridText}" FontSize="11"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource AbletonTextDim}"
                                   Visibility="{Binding BeatGridText,
                                                Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Key -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="TONART" Style="{StaticResource ParamLabel}"/>
                        <TextBlock Text="{Binding Key}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource AbletonGreen}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Beats -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="BEATS ERKANNT" Style="{StaticResource ParamLabel}"/>
                        <TextBlock Text="{Binding BeatCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AbletonYellow}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Duration -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="DAUER" Style="{StaticResource ParamLabel}"/>
                        <TextBlock Text="{Binding SelectedClip.DurationText}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AbletonBlue}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
