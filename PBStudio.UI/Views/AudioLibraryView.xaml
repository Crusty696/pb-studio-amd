<UserControl x:Class="PBStudio.UI.Views.AudioLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}">

    <UserControl.Resources>
        <!-- Flat compact button for batch actions -->
        <Style x:Key="BatchBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action button (accent outline) -->
        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AbletonAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Metric card -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AbletonSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- List item style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#28FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30FF764D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left Panel: Audio List ══ -->
        <md:Card Grid.Column="0" Style="{StaticResource AbletonCard}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="AUDIO-CLIPS"
                           Style="{StaticResource SectionHeader}"/>

                <!-- Batch actions -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding ImportAudioCommand}" Style="{StaticResource BatchBtn}"
                            ToolTip="Neue Audio-Dateien zur Bibliothek hinzufügen"
                            Foreground="{StaticResource AbletonAccent}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Plus" Width="12" Height="12"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Importieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,4"/>
                    <Button Command="{Binding SelectAllCommand}" Style="{StaticResource BatchBtn}"
                            Content="Alle"/>
                    <Button Command="{Binding DeselectAllCommand}" Style="{StaticResource BatchBtn}"
                            Content="Keine" Margin="2,0"/>
                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,4"/>
                    <Button Command="{Binding AnalyzeAllCommand}" Style="{StaticResource BatchBtn}"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlaylistCheck" Width="12" Height="12"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Alle analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Clip list -->
                <ListBox ItemsSource="{Binding AudioClips}"
                         SelectedItem="{Binding SelectedClip}"
                         DisplayMemberPath="Name"
                         Background="Transparent" BorderThickness="0"/>
            </DockPanel>
        </md:Card>

        <!-- ══ Right Panel: Analysis ══ -->
        <DockPanel Grid.Column="2">

            <!-- Action buttons row -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Command="{Binding AnalyzeSelectedCommand}" Style="{StaticResource ActionBtn}"
                        IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}"
                        ToolTip="Beat-Detection, BPM und Tonart analysieren" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="Waveform" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analysieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SeparateStemsCommand}" Style="{StaticResource ActionBtn}"
                        IsEnabled="{Binding IsSeparating, Converter={StaticResource InverseBooleanConverter}}"
                        ToolTip="Audio in 4 Stems aufteilen (Drums, Bass, Vocals, Other) – GPU-intensiv">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="TuneVertical" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Stems trennen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status bar at bottom -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource AbletonPanel}"
                    BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1"
                    CornerRadius="2" Padding="10,6" Margin="0,12,0,0">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Left" Width="100" Height="4"
                                 Value="{Binding AnalysisProgress}" Margin="0,0,12,0"
                                 Foreground="{StaticResource AbletonYellow}"
                                 Background="{StaticResource AbletonBorder}"
                                 Visibility="{Binding IsSeparating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AbletonTextDim}"
                               FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Section header -->
            <TextBlock DockPanel.Dock="Top" Text="ANALYSE-ERGEBNISSE"
                       Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

            <!-- Metric cards grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BPM -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="TEMPO" Style="{StaticResource ParamLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource AbletonAccent}"
                                       Text="{Binding Bpm, StringFormat={}{0:F1}}"/>
                            <TextBlock Text=" BPM" FontSize="13"
                                       Foreground="{StaticResource AbletonTextDim}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Key -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="TONART" Style="{StaticResource ParamLabel}"/>
                        <TextBlock Text="{Binding Key}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource AbletonGreen}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Beats -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="BEATS ERKANNT" Style="{StaticResource ParamLabel}"/>
                        <TextBlock Text="{Binding BeatCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AbletonYellow}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Duration -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="DAUER" Style="{StaticResource ParamLabel}"/>
                        <TextBlock Text="{Binding SelectedClip.DurationText}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AbletonBlue}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>