<UserControl x:Class="PBStudio.UI.Views.BrainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}">

    <UserControl.InputBindings>
        <KeyBinding Key="D1" Command="{Binding RatePerfectCommand}"/>
        <KeyBinding Key="D2" Command="{Binding RateFitsCommand}"/>
        <KeyBinding Key="D3" Command="{Binding RateNotQuiteCommand}"/>
        <KeyBinding Key="D4" Command="{Binding RateNoMatchCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Total clicks + cold/learned axes -->
        <md:Card Grid.Row="0" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="HIRN-STATUS" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Klicks gesamt: "
                                   Foreground="{StaticResource AbletonText}"/>
                        <TextBlock Text="{Binding TotalClicks}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AbletonAccent}"/>
                        <TextBlock Text="   |   gelernt: "
                                   Foreground="{StaticResource AbletonText}" Margin="20,0,0,0"/>
                        <TextBlock Text="{Binding LearnedAxes}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AbletonAccent}"/>
                        <TextBlock Text="/17 Achsen"
                                   Foreground="{StaticResource AbletonTextDim}"/>
                        <TextBlock Text="   |   Cold-Start: "
                                   Foreground="{StaticResource AbletonText}" Margin="20,0,0,0"/>
                        <TextBlock Text="{Binding ColdStartAxes}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AbletonAccent}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="↻ Aktualisieren"
                        Command="{Binding RefreshStatsCommand}"
                        Padding="12,4"/>
            </Grid>
        </md:Card>

        <!-- Cut-Selection + 4-Klick-Bewertung -->
        <md:Card Grid.Row="1" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="CUT BEWERTEN" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Cut-ID:" VerticalAlignment="Center"
                               Foreground="{StaticResource AbletonText}"/>
                    <TextBox Width="80" Margin="6,0,16,0"
                             Text="{Binding SelectedCutId, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource AbletonSurface}"
                             Foreground="{StaticResource AbletonText}"
                             BorderBrush="{StaticResource AbletonBorder}"/>
                    <Button Content="1 Passt perfekt"
                            Command="{Binding RatePerfectCommand}"
                            Background="#2A8C40" Foreground="White"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="2 Passt"
                            Command="{Binding RateFitsCommand}"
                            Background="#2A6080" Foreground="White"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="3 Passt nicht ganz"
                            Command="{Binding RateNotQuiteCommand}"
                            Background="#A06820" Foreground="White"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="4 Passt gar nicht"
                            Command="{Binding RateNoMatchCommand}"
                            Background="#A03030" Foreground="White"
                            Padding="14,6"/>
                </StackPanel>
                <TextBlock Text="Hotkeys: 1-4" Margin="0,4,0,0"
                           Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
            </StackPanel>
        </md:Card>

        <!-- Cold-Start-Achsen (welche Achsen brauchen mehr Klicks?) -->
        <md:Card Grid.Row="2" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="COLD-START ACHSEN (&lt; 10 Samples)"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6"/>
                <TextBlock DockPanel.Dock="Bottom"
                           Foreground="{StaticResource AbletonTextDim}"
                           FontSize="10" Margin="0,4,0,0"
                           Text="Diese Achsen ziehen die Confidence aus Defaults statt aus Daten — bewerte Cuts, in denen sie auftauchen, um sie aufzuwärmen."
                           TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding ColdStartAxesList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource AbletonSurface}"
                                    BorderBrush="{StaticResource AbletonBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="8,3"
                                    Margin="0,0,6,4">
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource AbletonText}"
                                           FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </md:Card>

        <!-- Top Buckets + Learning Session -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <md:Card Grid.Column="0" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,4,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="TOP +"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding TopPositive}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Axis}" FontWeight="Bold"
                                               Foreground="{StaticResource AbletonText}"/>
                                    <TextBlock Foreground="{StaticResource AbletonAccent}" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="post="/><Run Text="{Binding Posterior, StringFormat={}{0:P0}, Mode=OneWay}"/>
                                        <Run Text="  var="/><Run Text="{Binding PosteriorVariance, StringFormat={}{0:F4}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="10">
                                        <Run Text="α="/><Run Text="{Binding PositiveCount, StringFormat={}{0:F0}}"/>
                                        <Run Text="  β="/><Run Text="{Binding NegativeCount, StringFormat={}{0:F0}}"/>
                                        <Run Text="  L="/><Run Text="{Binding ContextLevel}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </md:Card>

            <md:Card Grid.Column="1" Style="{StaticResource AbletonCard}" Padding="14" Margin="4,0,4,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="TOP −"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding TopNegative}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Axis}" FontWeight="Bold"
                                               Foreground="{StaticResource AbletonText}"/>
                                    <TextBlock Foreground="{StaticResource AbletonAccent}" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="post="/><Run Text="{Binding Posterior, StringFormat={}{0:P0}, Mode=OneWay}"/>
                                        <Run Text="  var="/><Run Text="{Binding PosteriorVariance, StringFormat={}{0:F4}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="10">
                                        <Run Text="α="/><Run Text="{Binding PositiveCount, StringFormat={}{0:F0}}"/>
                                        <Run Text="  β="/><Run Text="{Binding NegativeCount, StringFormat={}{0:F0}}"/>
                                        <Run Text="  L="/><Run Text="{Binding ContextLevel}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </md:Card>

            <md:Card Grid.Column="2" Style="{StaticResource AbletonCard}" Padding="14" Margin="4,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="LERN-SESSION"
                                   Style="{StaticResource SectionHeader}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Liste"
                                    Command="{Binding LoadLearningSessionCommand}"
                                    Padding="10,2" Margin="0,0,4,0"/>
                            <Button Content="▶ Walkthrough"
                                    Command="{Binding OpenLearningSessionDialogCommand}"
                                    Padding="10,2"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding LearningSessionCuts}"
                             SelectedItem="{Binding SelectedLearningSessionCut, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"
                                               Foreground="{StaticResource AbletonText}">
                                        <Run Text="cut "/><Run Text="{Binding CutId}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11">
                                        <Run Text="{Binding ClipId}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding StartTime, StringFormat={}{0:F2}s}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </md:Card>
        </Grid>

        <!-- Reset + Status -->
        <md:Card Grid.Row="4" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AbletonTextDim}"/>
                <Button Grid.Column="1"
                        Content="Reset anfordern"
                        Command="{Binding ResetRequestCommand}"
                        Margin="0,0,8,0"
                        Padding="12,4"
                        IsEnabled="{Binding IsResetPending, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Grid.Column="2"
                        Content="Reset bestätigen"
                        Command="{Binding ResetConfirmCommand}"
                        Background="#A03030" Foreground="White"
                        Padding="12,4"
                        IsEnabled="{Binding IsResetPending}"/>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
