<UserControl x:Class="PBStudio.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:models="clr-namespace:PBStudio.UI.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChatViewModel}"
             Background="{StaticResource AbletonBg}"
             AutomationProperties.Name="KI-Chat"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource AbletonTextDim}"
                               Margin="0,0,12,0"
                               Text="Mode:"/>
                    <ComboBox VerticalAlignment="Center"
                              Width="100"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding Mode}"
                              AutomationProperties.Name="Chat-Modus"
                              AutomationProperties.HelpText="Wählt den Arbeitsmodus des KI-Chats."/>
                    <Button Command="{Binding ClearCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            Padding="6,4" Height="28"
                            ToolTip="Chat-History leeren"
                            AutomationProperties.Name="Chat-Verlauf leeren"
                            AutomationProperties.HelpText="Löscht den Verlauf nur, wenn das Backend die Löschung bestätigt; bei Fehler bleibt er sichtbar."
                            AutomationProperties.AcceleratorKey="Strg+L">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Clear" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="KI-CHAT" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource AbletonTextDim}"
                               FontSize="11" Margin="0,2,0,0"
                               AutomationProperties.Name="{Binding StatusText}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Message-Liste ═══ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessagesScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,12">
            <ItemsControl ItemsSource="{Binding Messages}"
                          AutomationProperties.Name="Chat-Nachrichten">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                        <Border Margin="0,0,0,12"
                                Padding="12,10"
                                CornerRadius="6"
                                Background="{StaticResource AbletonPanel}"
                                BorderBrush="{StaticResource AbletonBorder}"
                                BorderThickness="1">
                            <StackPanel>
                                <!-- Header: Rolle + Modell + Timestamp -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding TimestampDisplay}"
                                               FontSize="10"
                                               Foreground="{StaticResource AbletonTextDim}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AbletonBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AbletonAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RoleLabel}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding ModelName, StringFormat='via {0}'}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource AbletonTextDim}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ModelName, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Content -->
                                <TextBox Text="{Binding Content, Mode=OneWay}"
                                         TextWrapping="Wrap"
                                         Foreground="{StaticResource AbletonText}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         FontSize="13"
                                         Padding="0"
                                         Cursor="IBeam"/>

                                <!-- Streaming-Indikator -->
                                <TextBlock Text="..."
                                           FontSize="13"
                                           Foreground="{StaticResource AbletonTextDim}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>

                                <!-- Tool-Calls -->
                                <ItemsControl ItemsSource="{Binding ToolCalls}"
                                              Margin="0,8,0,0"
                                              Visibility="{Binding HasToolCalls, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ToolCallInfo}">
                                            <Expander Margin="0,2,0,0"
                                                      Background="{StaticResource AbletonBg}"
                                                      BorderBrush="{StaticResource AbletonBorder}"
                                                      BorderThickness="1">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconMaterial Kind="Function"
                                                                               Width="12" Height="12"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource AbletonAccent}"
                                                                               Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AbletonText}"/>
                                                        <TextBlock Text=" ✓"
                                                                   FontSize="11"
                                                                   Foreground="LimeGreen"
                                                                   Margin="6,0,0,0"
                                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="8,4,8,8">
                                                    <TextBlock Text="Arguments:"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AbletonTextDim}"
                                                               Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding ArgumentsJson, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             FontFamily="Consolas"
                                                             FontSize="10"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             TextWrapping="Wrap"
                                                             Foreground="{StaticResource AbletonText}"/>
                                                    <TextBlock Text="Result:"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AbletonTextDim}"
                                                               Margin="0,6,0,2"/>
                                                    <TextBox Text="{Binding ResultJson, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             FontFamily="Consolas"
                                                             FontSize="10"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             TextWrapping="Wrap"
                                                             MaxHeight="200"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Foreground="{StaticResource AbletonText}"/>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Error -->
                                <Border Margin="0,8,0,0"
                                        Padding="8,4"
                                        Background="#FF3A1212"
                                        BorderBrush="#FF8B1A1A"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding ErrorText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             TextWrapping="Wrap"
                                             FontSize="11"
                                             Foreground="#FFFFB0B0"
                                             AutomationProperties.Name="{Binding ErrorText}"
                                             AutomationProperties.LiveSetting="Assertive"
                                             Focusable="True"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══ Eingabe ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         MinHeight="36"
                         MaxHeight="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center"
                         md:HintAssist.Hint="Frag mich was — z.B. 'Liste meine Audio-Clips'"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AutomationProperties.Name="Chat-Nachricht"
                         AutomationProperties.HelpText="Nachricht eingeben. Strg+Eingabe sendet; Eingabe allein erzeugt eine neue Zeile."
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="8,0,0,0"
                        Height="36"
                        Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"
                        ToolTip="Streaming abbrechen"
                        AutomationProperties.Name="Antwort abbrechen"
                        AutomationProperties.HelpText="Bricht die laufende KI-Antwort ab."
                        AutomationProperties.AcceleratorKey="Escape">
                    <icon:PackIconMaterial Kind="Stop" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="2"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AbletonAccent}"
                        Margin="8,0,0,0"
                        Padding="14,0"
                        Height="36"
                        AutomationProperties.Name="Chat-Nachricht senden"
                        AutomationProperties.HelpText="Sendet die eingegebene Nachricht an den ausgewählten Chat-Modus."
                        AutomationProperties.AcceleratorKey="Strg+Eingabe">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="Send" Width="14" Height="14"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Senden" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
