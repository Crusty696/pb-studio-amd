<Window x:Class="PBStudio.UI.Views.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DownloadProgressViewModel}"
        Title="Modell-Download"
        Height="240" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AbletonBg}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <icon:PackIconMaterial Kind="Download" Width="18" Height="18"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AbletonAccent}"
                                   Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource AbletonText}">
                <Run Text="Lade Modell: "/><Run Text="{Binding ModelName, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource AbletonAccent}"
                   FontSize="12" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="2"
                     Height="10"
                     Value="{Binding Percent, Mode=OneWay}"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     Minimum="0" Maximum="100"
                     Foreground="{StaticResource AbletonAccent}"
                     Margin="0,4,0,8"/>

        <!-- Detail-Text -->
        <StackPanel Grid.Row="3" VerticalAlignment="Top">
            <TextBlock Text="{Binding DetailText}"
                       Foreground="{StaticResource AbletonTextDim}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <!-- Error-Banner -->
            <Border Padding="8,6"
                    Margin="0,6,0,0"
                    Background="#33FF4444"
                    BorderBrush="{StaticResource AbletonRed}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="AlertCircle" Width="14" Height="14"
                                           Foreground="{StaticResource AbletonRed}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ErrorText, Mode=OneWay}"
                               Foreground="{StaticResource AbletonRed}"
                               Background="Transparent"
                               BorderThickness="0"
                               IsReadOnly="True"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Padding="0"
                               Cursor="IBeam"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Cancel waehrend Download -->
            <Button Content="Abbrechen"
                    Command="{Binding CancelCommand}"
                    Foreground="{StaticResource AbletonRed}"
                    Padding="14,4">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Schliessen wenn fertig -->
            <Button Content="Schliessen"
                    Click="OnCloseClicked"
                    Background="{StaticResource AbletonAccent}"
                    BorderThickness="0"
                    Padding="14,4"
                    Margin="8,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
