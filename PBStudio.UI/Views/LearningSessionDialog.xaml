<Window x:Class="PBStudio.UI.Views.LearningSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Lern-Session — 15 unsicherste Cuts"
        Height="540" Width="780"
        Background="{StaticResource AbletonBg}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Lern-Session"
        KeyboardNavigation.TabNavigation="Cycle">

    <Window.InputBindings>
        <KeyBinding Key="D1" Command="{Binding RatePerfectCommand}"/>
        <KeyBinding Key="D2" Command="{Binding RateFitsCommand}"/>
        <KeyBinding Key="D3" Command="{Binding RateNotQuiteCommand}"/>
        <KeyBinding Key="D4" Command="{Binding RateNoMatchCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PrevCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <md:Card Grid.Row="0" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <Run Text="LERN-SESSION  ("/><Run Text="{Binding CurrentIndexDisplay, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource AbletonTextDim}">
                    <Run Text="cut_id="/><Run Text="{Binding CurrentCutId, Mode=OneWay}"/>
                    <Run Text="  clip="/><Run Text="{Binding CurrentClipId, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </md:Card>

        <!-- Video preview -->
        <md:Card Grid.Row="1" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: video -->
                <Border Grid.Column="0"
                        Background="Black"
                        BorderBrush="{StaticResource AbletonBorder}"
                        BorderThickness="1">
                    <MediaElement x:Name="VideoPlayer"
                                  Source="{Binding CurrentVideoUri, Mode=OneWay}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Volume="0.0"
                                  ScrubbingEnabled="True"
                                  Stretch="Uniform"/>
                </Border>

                <!-- Right: audio + scores -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="AUDIO" Style="{StaticResource SectionHeader}"/>
                    <MediaElement x:Name="AudioPlayer"
                                  Source="{Binding CurrentAudioUri, Mode=OneWay}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Volume="0.7"
                                  Visibility="Collapsed"/>

                    <TextBlock Margin="0,8,0,4" Foreground="{StaticResource AbletonTextDim}">
                        <Run Text="t="/><Run Text="{Binding CurrentStartTime, Mode=OneWay, StringFormat={}{0:F2}s}"/>
                        <Run Text=" → "/><Run Text="{Binding CurrentEndTime, Mode=OneWay, StringFormat={}{0:F2}s}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}">
                        <Run Text="brain_score="/><Run Text="{Binding CurrentFinalScore, Mode=OneWay, StringFormat={}{0:F3}}"/>
                    </TextBlock>

                    <Rectangle Height="6"
                               Margin="0,4,0,0"
                               Fill="{Binding CurrentFinalScore, Converter={StaticResource ConfidenceToBrushConverter}}"/>

                    <Separator Margin="0,12,0,8"/>

                    <Button Content="{Binding PlayPauseLabel}"
                            Command="{Binding PlayPauseCommand}"
                            Padding="12,4" Margin="0,0,0,4"
                            AutomationProperties.Name="{Binding PlayPauseLabel}"
                            AutomationProperties.HelpText="Startet oder pausiert die synchronisierte Vorschau."/>
                    <Button Content="↻ Restart"
                            Command="{Binding RestartCommand}"
                            Padding="12,4"
                            AutomationProperties.Name="Vorschau neu starten"
                            AutomationProperties.HelpText="Startet die aktuelle Audio- und Video-Vorschau am Anfang neu."/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- 4-button rating -->
        <md:Card Grid.Row="2" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="1 Passt perfekt"
                        Command="{Binding RatePerfectCommand}"
                        Background="#2A8C40" Foreground="White"
                        Padding="14,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Bewertung: passt perfekt"
                        AutomationProperties.HelpText="Bewertet den aktuellen Schnitt als perfekte Zuordnung und wechselt zum nächsten Schnitt."
                        AutomationProperties.AcceleratorKey="1"/>
                <Button Content="2 Passt"
                        Command="{Binding RateFitsCommand}"
                        Background="#2A6080" Foreground="White"
                        Padding="14,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Bewertung: passt"
                        AutomationProperties.HelpText="Bewertet den aktuellen Schnitt als passende Zuordnung und wechselt zum nächsten Schnitt."
                        AutomationProperties.AcceleratorKey="2"/>
                <Button Content="3 Passt nicht ganz"
                        Command="{Binding RateNotQuiteCommand}"
                        Background="#A06820" Foreground="White"
                        Padding="14,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Bewertung: passt nicht ganz"
                        AutomationProperties.HelpText="Bewertet den aktuellen Schnitt als eher unpassend und wechselt zum nächsten Schnitt."
                        AutomationProperties.AcceleratorKey="3"/>
                <Button Content="4 Passt gar nicht"
                        Command="{Binding RateNoMatchCommand}"
                        Background="#A03030" Foreground="White"
                        Padding="14,8"
                        AutomationProperties.Name="Bewertung: passt gar nicht"
                        AutomationProperties.HelpText="Bewertet den aktuellen Schnitt als unpassend und wechselt zum nächsten Schnitt."
                        AutomationProperties.AcceleratorKey="4"/>
            </StackPanel>
        </md:Card>

        <!-- Status + Nav -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AbletonTextDim}"
                       Text="{Binding Status}"
                       AutomationProperties.Name="{Binding Status}"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Content="◀ _Zurück" Command="{Binding PrevCommand}" Padding="10,4" Margin="0,0,4,0"
                    AutomationProperties.Name="Vorheriger Schnitt"
                    AutomationProperties.HelpText="Zeigt den vorherigen Schnitt zur Bewertung."
                    AutomationProperties.AcceleratorKey="Pfeil links"/>
            <Button Grid.Column="2" Content="_Weiter ▶" Command="{Binding NextCommand}" Padding="10,4" Margin="0,0,4,0"
                    AutomationProperties.Name="Nächster Schnitt"
                    AutomationProperties.HelpText="Zeigt den nächsten Schnitt zur Bewertung."
                    AutomationProperties.AcceleratorKey="Pfeil rechts"/>
            <Button Grid.Column="3" Content="_Schließen" Command="{Binding CloseCommand}" Padding="10,4"
                    IsCancel="True"
                    AutomationProperties.Name="Lern-Session schließen"
                    AutomationProperties.HelpText="Beendet die Lern-Session."
                    AutomationProperties.AcceleratorKey="Escape"/>
        </Grid>
    </Grid>
</Window>
