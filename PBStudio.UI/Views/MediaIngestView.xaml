<UserControl x:Class="PBStudio.UI.Views.MediaIngestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}"
             AutomationProperties.Name="Medienimport"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.InputBindings>
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding ImportAudioCommand}"/>
        <KeyBinding Key="V" Modifiers="Alt" Command="{Binding ImportVideoCommand}"/>
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding BrowseVideoPathCommand}"/>
        <KeyBinding Key="I" Modifiers="Alt" Command="{Binding ImportVideoFromPathCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Compact GridView column header -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource AbletonPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Compact ListView item -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#28FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30FF764D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top Toolbar ── -->
        <Border Grid.Row="0" Style="{StaticResource AbletonToolbar}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ImportAudioCommand}" Style="{StaticResource ToolbarBtn}"
                        ToolTip="Audio-Datei(en) importieren (WAV, MP3, FLAC)"
                        AutomationProperties.Name="Audio-Dateien importieren"
                        AutomationProperties.HelpText="Öffnet die Dateiauswahl für WAV-, MP3- und FLAC-Dateien."
                        AutomationProperties.AccessKey="Alt+A">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="MusicNotePlus" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Audio importieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                <Button Command="{Binding ImportVideoCommand}" Style="{StaticResource ToolbarBtn}"
                        ToolTip="Video-Datei(en) importieren (MP4, MOV, AVI)"
                        AutomationProperties.Name="Video-Dateien importieren"
                        AutomationProperties.HelpText="Öffnet die Dateiauswahl für MP4-, MOV- und AVI-Dateien."
                        AutomationProperties.AccessKey="Alt+V">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="VideoPlus" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Video importieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                <TextBox Width="320"
                         Margin="6,0,6,0"
                         Text="{Binding VideoImportPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Video-Importpfade"
                         AutomationProperties.HelpText="Vollständige Pfade eingeben; mehrere Pfade mit Semikolon oder Zeilenumbruch trennen."
                         ToolTip="Workaround für flakigen Windows-Dateidialog: vollständigen Video-Pfad direkt eingeben. Mehrere Pfade via Semikolon oder neue Zeile trennen."/>

                <Button Command="{Binding BrowseVideoPathCommand}" Style="{StaticResource ToolbarBtn}"
                        ToolTip="Video-Dateien auswählen und nur den/die Pfad/Pfade in das In-App-Feld übernehmen"
                        AutomationProperties.Name="Video-Pfade auswählen"
                        AutomationProperties.HelpText="Übernimmt ausgewählte Video-Dateipfade in das Eingabefeld, ohne sie sofort zu importieren."
                        AutomationProperties.AccessKey="Alt+P">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="FolderSearchOutline" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Pfad wählen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ImportVideoFromPathCommand}" Style="{StaticResource ToolbarBtn}"
                        ToolTip="Video direkt vom angegebenen Pfad importieren, ohne den nativen Import-Lauf zu verwenden"
                        AutomationProperties.Name="Videos aus Pfaden importieren"
                        AutomationProperties.HelpText="Importiert alle gültigen Pfade aus dem Eingabefeld."
                        AutomationProperties.AccessKey="Alt+I">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="FileImportOutline" Width="14" Height="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Pfad importieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ── Two-Column Content ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Audio Column -->
            <md:Card Grid.Column="0" Style="{StaticResource AbletonCard}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="AUDIO-DATEIEN"
                               Style="{StaticResource SectionHeader}"/>

                    <ListView ItemsSource="{Binding ImportedAudio}"
                              Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="Importierte Audio-Dateien"
                              AutomationProperties.HelpText="Liste der im aktiven Projekt importierten Audio-Dateien.">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="Dauer" DisplayMemberBinding="{Binding DurationText}" Width="70"/>
                                <GridViewColumn Header="Format" DisplayMemberBinding="{Binding Format}" Width="55"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </md:Card>

            <!-- Video Column -->
            <md:Card Grid.Column="2" Style="{StaticResource AbletonCard}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VIDEO-DATEIEN"
                               Style="{StaticResource SectionHeader}"/>

                    <ListView ItemsSource="{Binding ImportedVideo}"
                              Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="Importierte Video-Dateien"
                              AutomationProperties.HelpText="Liste der im aktiven Projekt importierten Video-Dateien.">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="Dauer" DisplayMemberBinding="{Binding DurationText}" Width="70"/>
                                <GridViewColumn Header="Auflösung" DisplayMemberBinding="{Binding ResolutionText}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </md:Card>
        </Grid>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="2" Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1"
                CornerRadius="2" Padding="10,6" Margin="0,12,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="180" Height="4"
                             Value="{Binding ImportProgress}" Margin="0,0,12,0"
                             Foreground="{StaticResource AbletonAccent}"
                             Background="{StaticResource AbletonBorder}"
                             Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AbletonTextDim}"
                           FontSize="11" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding StatusText}"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
