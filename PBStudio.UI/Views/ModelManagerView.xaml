<UserControl x:Class="PBStudio.UI.Views.ModelManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModelManagerViewModel}"
             Background="{StaticResource AbletonBg}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0"
                Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource AbletonTextDim}"
                               Margin="0,0,12,0"
                               Visibility="{Binding LastFetchedAt, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Letzter Refresh: "/><Run Text="{Binding LastFetchedAt, StringFormat=HH:mm:ss, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            Padding="6,4" Height="28"
                            ToolTip="Modell-Liste neu laden">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MODELLE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource AbletonTextDim}"
                               FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Cards-Liste ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12">

                <!-- ══ Ollama-Offline Warnung ══ -->
                <Border Padding="12,10"
                        Margin="0,0,0,12"
                        Background="#33FF4444"
                        BorderBrush="{StaticResource AbletonRed}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="AlertCircle" Width="16" Height="16"
                                               Foreground="{StaticResource AbletonRed}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Foreground="{StaticResource AbletonRed}"
                                   FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <Run Text="Ollama nicht erreichbar: "/><Run Text="{Binding ErrorText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ══ Installiert ══ -->
                <TextBlock Text="INSTALLIERT"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AbletonAccent}"
                           Margin="0,0,0,8"/>

                <!-- Empty-State Installiert -->
                <TextBlock Text="Keine Modelle installiert. Waehle eines aus der Verfuegbaren-Liste."
                           Foreground="{StaticResource AbletonTextDim}"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,4,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InstalledModels.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding InstalledModels}" Margin="0,0,0,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InstalledModelCardViewModel}">
                            <md:Card Style="{StaticResource AbletonCard}"
                                     Padding="14"
                                     Margin="0,0,12,12"
                                     Width="360">
                                <StackPanel>
                                    <!-- Header: Name + Delete -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DeleteCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource AbletonRed}"
                                                Padding="6,2" Height="24"
                                                ToolTip="Modell loeschen">
                                            <StackPanel Orientation="Horizontal">
                                                <icon:PackIconMaterial Kind="Delete" Width="13" Height="13"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Loeschen" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AbletonAccent}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <!-- Detail-Grid -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="GROESSE" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding SizeDisplay}"
                                                       Style="{StaticResource ParamValue}"
                                                       Foreground="{StaticResource AbletonGreen}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PARAMS" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding ParameterSize}"
                                                       Style="{StaticResource ParamValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="QUANT" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding Quantization}"
                                                       Style="{StaticResource ParamValue}"
                                                       Foreground="{StaticResource AbletonTextDim}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource AbletonTextDim}"
                                               FontSize="10">
                                        <Run Text="modified "/><Run Text="{Binding ModifiedDisplay, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Busy-Overlay -->
                                    <ProgressBar Height="3" Margin="0,8,0,0"
                                                 IsIndeterminate="True"
                                                 Foreground="{StaticResource AbletonAccent}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ Verfuegbar ══ -->
                <TextBlock Text="VERFUEGBAR"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AbletonTextDim}"
                           Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding AvailableModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AvailableModelCardViewModel}">
                            <md:Card Style="{StaticResource AbletonCard}"
                                     Padding="14"
                                     Margin="0,0,12,12"
                                     Width="360">
                                <StackPanel>
                                    <!-- Header: Name + Mode-Badge -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource AbletonPanel}"
                                                BorderBrush="{StaticResource AbletonBorder}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding ModeBadge}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource AbletonAccent}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AbletonText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,6,0"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource AbletonTextDim}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding SizeDisplay}"
                                                   Style="{StaticResource ParamValue}"
                                                   Foreground="{StaticResource AbletonGreen}"
                                                   VerticalAlignment="Center"/>

                                        <!-- "Installiert"-Badge wenn vorhanden, sonst Download-Button -->
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding Installed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <icon:PackIconMaterial Kind="CheckCircle" Width="14" Height="14"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource AbletonGreen}"
                                                                   Margin="0,0,4,0"/>
                                            <TextBlock Text="Installiert" FontSize="11"
                                                       Foreground="{StaticResource AbletonGreen}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DownloadCommand}"
                                                Foreground="{StaticResource AbletonAccent}"
                                                HorizontalAlignment="Right"
                                                Padding="8,2" Height="28"
                                                ToolTip="Modell herunterladen via Ollama-Pull">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <icon:PackIconMaterial Kind="Download" Width="14" Height="14"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Download" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>

                                    <ProgressBar Height="3" Margin="0,8,0,0"
                                                 IsIndeterminate="True"
                                                 Foreground="{StaticResource AbletonAccent}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
