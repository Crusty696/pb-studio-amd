<UserControl x:Class="PBStudio.UI.Views.ModelManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:conv="clr-namespace:PBStudio.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModelManagerViewModel}"
             Background="{StaticResource AbletonBg}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             AutomationProperties.Name="Modellverwaltung"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0"
                Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource AbletonTextDim}"
                               Margin="0,0,12,0"
                               Visibility="{Binding LastFetchedAt, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Letzter Refresh: "/><Run Text="{Binding LastFetchedAt, StringFormat=HH:mm:ss, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            Padding="6,4" Height="28"
                            ToolTip="Modell-Liste aktualisieren&#x0a;• Was es macht: Fragt den aktiven LLM-Provider (z.B. LM Studio) nach allen installierten und geladenen Modellen ab.&#x0a;• Wozu es dient: Bringt die Liste der verfügbaren Modelle auf den neuesten Stand, wenn du in LM Studio neue Modelle hinzugefügt hast.&#x0a;• Wann &amp; wie nutzen: Immer dann anklicken, wenn du ein neues Modell in LM Studio geladen hast und dieses hier nicht sofort siehst."
                            AutomationProperties.Name="Modell-Liste aktualisieren"
                            AutomationProperties.HelpText="Lädt Providerstatus sowie installierte, aktive und verfügbare Modelle neu."
                            AutomationProperties.AcceleratorKey="F5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MODELLE" Style="{StaticResource SectionHeader}"/>
                        <!-- W-QA-2 (2026-05-22): Provider-Badge zeigt live welcher LLM-Stack aktiv ist. -->
                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="2"
                                Background="{StaticResource AbletonAccent}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProviderBadge}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="Black"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource AbletonTextDim}"
                               FontSize="11" Margin="0,2,0,0"
                               AutomationProperties.Name="{Binding StatusText}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding ProviderStatusText}"
                               Foreground="{StaticResource AbletonTextDim}"
                               FontSize="10" Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Cards-Liste ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12">

                <!-- ══ Ollama-Offline Warnung ══ -->
                <Border Padding="12,10"
                        Margin="0,0,0,12"
                        Background="#33FF4444"
                        BorderBrush="{StaticResource AbletonRed}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="AlertCircle" Width="16" Height="16"
                                               Foreground="{StaticResource AbletonRed}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Foreground="{StaticResource AbletonRed}"
                                   FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <Run Text="LLM-Provider offline: "/><Run Text="{Binding ErrorText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ══ Installiert ══ -->
                <TextBlock Text="INSTALLIERT"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AbletonAccent}"
                           Margin="0,0,0,8"/>

                <!-- Empty-State Installiert -->
                <TextBlock Text="Keine Modelle installiert. Waehle eines aus der Verfuegbaren-Liste."
                           Foreground="{StaticResource AbletonTextDim}"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,4,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InstalledModels.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding InstalledModels}" Margin="0,0,0,18"
                              AutomationProperties.Name="Installierte Modelle">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InstalledModelCardViewModel}">
                            <md:Card Padding="14"
                                     Margin="0,0,12,12"
                                     Width="360">
                                <md:Card.Style>
                                    <Style TargetType="md:Card" BasedOn="{StaticResource AbletonCard}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AbletonGreen}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:Card.Style>
                                <StackPanel>
                                    <!-- Header: Aktiv-Badge + Name + Capabilities + Delete -->
                                    <DockPanel Margin="0,0,0,8">
                                        <!-- In LM Studio Button (Delete-Command) -->
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DeleteCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource AbletonAccent}"
                                                Padding="6,2" Height="24"
                                                Opacity="0.65"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Modell {0} entfernen}"
                                                AutomationProperties.HelpText="Öffnet eine Anleitung zum sicheren Entfernen dieses Modells aus LM Studio."
                                                ToolTip="Modell entfernen&#x0a;• Was es macht: Zeigt eine Schritt-für-Schritt-Anleitung an, wie du das Modell sicher aus LM Studio entfernst.&#x0a;• Wozu es dient: Gibt wertvollen Festplattenspeicher frei, wenn du ein Modell nicht mehr benötigst.&#x0a;• Wann &amp; wie nutzen: Klicken, wenn du alte Modelle dauerhaft löschen willst, um Platz auf deinem Laufwerk zu schaffen.">
                                            <StackPanel Orientation="Horizontal">
                                                <icon:PackIconMaterial Kind="TrashCanOutline" Width="13" Height="13"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Entfernen" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Aktiv-Badge (nur wenn aktiv) -->
                                        <Border DockPanel.Dock="Left" Margin="0,0,8,0" Padding="6,2" CornerRadius="2"
                                                Background="{StaticResource AbletonGreen}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="AKTIV" FontSize="10" FontWeight="Bold" Foreground="Black"/>
                                        </Border>

                                        <!-- Name -->
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AbletonText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <!-- Capabilities & Tasks -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <!-- Capabilities (z.B. Vision & Text oder Text) -->
                                        <Border Padding="6,2" CornerRadius="2"
                                                Background="{StaticResource AbletonPanel}"
                                                BorderBrush="{StaticResource AbletonBorder}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CapabilitiesText}" FontSize="10"
                                                       Foreground="{StaticResource AbletonAccent}"/>
                                        </Border>

                                        <!-- Provider Badge (Ollama/LM Studio/Beide) -->
                                        <Border Padding="6,2" CornerRadius="2"
                                                Margin="6,0,0,0"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AbletonPanel}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Provider}" Value="ollama">
                                                            <Setter Property="Background" Value="#154060"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AbletonBlue}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Provider}" Value="lmstudio">
                                                            <Setter Property="Background" Value="#4d2215"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AbletonAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ProviderBadgeText}" FontSize="10"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Provider}" Value="ollama">
                                                                <Setter Property="Foreground" Value="{StaticResource AbletonBlue}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Provider}" Value="lmstudio">
                                                                <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Border Padding="6,2" CornerRadius="2"
                                                Margin="6,0,0,0"
                                                Background="{StaticResource AbletonPanel}"
                                                BorderBrush="{StaticResource AbletonBorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding StateText}"
                                                       FontSize="10"
                                                       Foreground="{Binding StateColor}"/>
                                        </Border>

                                        <!-- Aktive Zuweisungen (falls aktiv) -->
                                        <TextBlock Text="{Binding ActiveTasksText}" FontSize="10" 
                                                   Foreground="{StaticResource AbletonGreen}"
                                                   FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Beschreibung -->
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource AbletonTextDim}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Height="34"
                                               TextTrimming="WordEllipsis"
                                               ToolTip="{Binding Description}"/>
                                    <TextBlock Text="{Binding StatusReason}"
                                               Foreground="{StaticResource AbletonTextDim}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               ToolTip="{Binding StatusReason}"/>

                                    <!-- Detail-Grid (Groesse, Params, Quant) -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="GROESSE" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding SizeDisplay}"
                                                       Style="{StaticResource ParamValue}"
                                                       Foreground="{StaticResource AbletonGreen}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PARAMS" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding ParameterSize}"
                                                       Style="{StaticResource ParamValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="QUANT" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding Quantization}"
                                                       Style="{StaticResource ParamValue}"
                                                       Foreground="{StaticResource AbletonTextDim}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- modified-Text und Busy-Overlay -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Foreground="{StaticResource AbletonTextDim}"
                                                   FontSize="10" VerticalAlignment="Center">
                                            <Run Text="modified "/><Run Text="{Binding ModifiedDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Steuerung & Test Footer -->
                                    <Border BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,2,0,0">
                                        <DockPanel LastChildFill="True">
                                            <!-- GPU-Test Button links -->
                                            <Button DockPanel.Dock="Left"
                                                    Command="{Binding TestCommand}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="{StaticResource AbletonAccent}"
                                                    Padding="6,2" Height="26"
                                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=DirectML-Test für {0}}"
                                                    AutomationProperties.HelpText="Führt eine kurze, providergebundene Test-Inferenz auf der ausgewählten AMD-GPU aus."
                                                    ToolTip="DirectML GPU-Smoke-Test&#x0a;• Was es macht: Führt eine kleine Test-Inferenz auf deiner AMD-Grafikkarte über die DirectML-Schnittstelle aus.&#x0a;• Wozu es dient: Verifiziert blitzschnell, ob das Modell auf deiner GPU fehlerfrei und beschleunigt läuft.&#x0a;• Wann &amp; wie nutzen: Direkt nach der ersten Installation oder Aktivierung eines Modells ausführen, um Kompatibilitätsprobleme sofort aufzudecken.">
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconMaterial Kind="PlayCircleOutline" Width="14" Height="14"
                                                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                                                           Visibility="{Binding IsTesting, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                    <!-- Lade-Spinner, wenn getestet wird -->
                                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                                 Value="0" IsIndeterminate="True"
                                                                 Width="12" Height="12" Margin="0,0,4,0"
                                                                 Foreground="{StaticResource AbletonAccent}"
                                                                 Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="GPU-Test" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Aktivieren Button rechts (ausblenden, wenn bereits aktiv) -->
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding ActivateCommand}"
                                                    Foreground="Black"
                                                    Background="{StaticResource AbletonGreen}"
                                                    BorderBrush="{StaticResource AbletonGreen}"
                                                    Padding="12,2" Height="26"
                                                    HorizontalAlignment="Right"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Modell {0} aktivieren}"
                                                    AutomationProperties.HelpText="Aktiviert dieses Modell als bevorzugtes Hauptmodell und bestätigt die persistierte Auswahl."
                                                    ToolTip="Als Hauptmodell aktivieren&#x0a;• Was es macht: Setzt das gewählte Modell als Standard-Modell für alle zukünftigen Chat- und Analyse-Aufgaben fest.&#x0a;• Wozu es dient: Stellt sicher, dass PB Studio für den KI-Chat und die Director-Analysen immer dein bevorzugtes Modell anspricht.&#x0a;• Wann &amp; wie nutzen: Anklicken, wenn du ein anderes Modell (z.B. ein größeres für bessere Qualität oder ein kleineres für mehr Performance) standardmäßig verwenden möchtest.">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconMaterial Kind="CheckBold" Width="12" Height="12"
                                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Aktivieren" FontSize="11" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Teststatus mittig -->
                                            <TextBlock Text="{Binding TestStatus}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="6,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestStatus}" Value="Wird getestet...">
                                                                <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TestStatusColor}" Value="#00FF66">
                                                                <Setter Property="Foreground" Value="{StaticResource AbletonGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TestStatusColor}" Value="#FF4444">
                                                                <Setter Property="Foreground" Value="{StaticResource AbletonRed}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>

                                    <!-- Busy-Overlay -->
                                    <ProgressBar Height="3" Margin="0,6,0,0"
                                                 IsIndeterminate="True"
                                                 Foreground="{StaticResource AbletonAccent}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ Verfuegbar ══ -->
                <TextBlock Text="LIVE-VERIFIZIERTE DOWNLOADS"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AbletonTextDim}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding DiscoverActionsText}"
                           Foreground="{StaticResource AbletonTextDim}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Keine individuellen Downloadmodelle wurden live verifiziert. Es werden keine statischen Modellkarten eingeblendet."
                           Foreground="{StaticResource AbletonTextDim}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvailableModels.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding AvailableModels}"
                              AutomationProperties.Name="Verfügbare Modelle">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AvailableModelCardViewModel}">
                            <md:Card Style="{StaticResource AbletonCard}"
                                     Padding="14"
                                     Margin="0,0,12,12"
                                     Width="360">
                                <StackPanel>
                                    <!-- Header: Name + Mode-Badge -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource AbletonPanel}"
                                                BorderBrush="{StaticResource AbletonBorder}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding ModeBadge}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource AbletonAccent}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AbletonText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,6,0"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding ProviderLabel}"
                                               Foreground="{StaticResource AbletonAccent}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource AbletonTextDim}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding SizeDisplay}"
                                                   Style="{StaticResource ParamValue}"
                                                   Foreground="{StaticResource AbletonGreen}"
                                                   VerticalAlignment="Center"/>

                                        <!-- "Installiert"-Badge wenn vorhanden, sonst Download-Button -->
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding Installed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <icon:PackIconMaterial Kind="CheckCircle" Width="14" Height="14"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource AbletonGreen}"
                                                                   Margin="0,0,4,0"/>
                                            <TextBlock Text="Installiert" FontSize="11"
                                                       Foreground="{StaticResource AbletonGreen}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DownloadCommand}"
                                                Foreground="{StaticResource AbletonAccent}"
                                                HorizontalAlignment="Right"
                                                Padding="8,2" Height="28"
                                                Opacity="0.75"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Modell {0} herunterladen}"
                                                AutomationProperties.HelpText="{Binding DownloadToolTip}"
                                                ToolTip="{Binding DownloadToolTip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <icon:PackIconMaterial Kind="OpenInNew" Width="14" Height="14"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DownloadActionText}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>

                                    <ProgressBar Height="3" Margin="0,8,0,0"
                                                 IsIndeterminate="True"
                                                 Foreground="{StaticResource AbletonAccent}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
