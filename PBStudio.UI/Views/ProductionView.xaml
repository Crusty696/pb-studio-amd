<UserControl x:Class="PBStudio.UI.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:PBStudio.UI.Controls"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}">

    <DockPanel Margin="12">

        <!-- ══ Render Settings Card ══ -->
        <md:Card DockPanel.Dock="Top" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="RENDER SETTINGS" Style="{StaticResource SectionHeader}"/>

                <!-- Output Path -->
                <TextBlock Text="Ausgabe-Pfad" Style="{StaticResource ParamLabel}"/>
                <DockPanel Margin="0,2,0,10">
                    <Button DockPanel.Dock="Right" Command="{Binding BrowseOutputCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            Padding="8,4" Height="30" Margin="6,0,0,0"
                            ToolTip="Pfad für die fertige Video-Datei">
                        <icon:PackIconMaterial Kind="FolderOpen" Width="16" Height="16"/>
                    </Button>
                    <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource AbletonPanel}"
                             Foreground="{StaticResource AbletonText}"
                             BorderBrush="{StaticResource AbletonBorder}"
                             FontSize="12" Padding="6,4"
                             ToolTip="Pfad für die fertige Video-Datei"
                             VerticalContentAlignment="Center"/>
                </DockPanel>

                <!-- Quality + Resolution Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quality -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Qualität" Style="{StaticResource ParamLabel}"/>
                        <ComboBox ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality}"
                                  Background="{StaticResource AbletonPanel}"
                                  Foreground="{StaticResource AbletonText}"
                                  BorderBrush="{StaticResource AbletonBorder}"
                                  MinWidth="120" FontSize="12" Margin="0,2,0,0"
                                  ToolTip="Encoding-Qualität (höher = bessere Qualität, größere Datei)"/>
                    </StackPanel>

                    <!-- Resolution -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Auflösung" Style="{StaticResource ParamLabel}"
                                   ToolTip="Ausgabe-Auflösung und Bildrate"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource AbletonPanel}"
                                     Foreground="{StaticResource AbletonText}"
                                     BorderBrush="{StaticResource AbletonBorder}"
                                     Width="65" FontSize="12" Padding="4,4"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="x" Foreground="{StaticResource AbletonTextDim}"
                                       VerticalAlignment="Center" Margin="6,0" FontSize="12"/>
                            <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource AbletonPanel}"
                                     Foreground="{StaticResource AbletonText}"
                                     BorderBrush="{StaticResource AbletonBorder}"
                                     Width="65" FontSize="12" Padding="4,4"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="@" Foreground="{StaticResource AbletonTextDim}"
                                       VerticalAlignment="Center" Margin="6,0" FontSize="12"/>
                            <TextBox Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource AbletonPanel}"
                                     Foreground="{StaticResource AbletonText}"
                                     BorderBrush="{StaticResource AbletonBorder}"
                                     Width="50" FontSize="12" Padding="4,4"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="fps" Foreground="{StaticResource AbletonTextDim}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- L-N6: Encoder-Auswahl (AMD AMF only) -->
                <StackPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="Encoder" Style="{StaticResource ParamLabel}" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding Encoder}"
                                   Style="{StaticResource ParamValue}"
                                   Foreground="{StaticResource AbletonAccent}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding AvailableEncoders}"
                              SelectedItem="{Binding Encoder}"
                              Background="{StaticResource AbletonPanel}"
                              Foreground="{StaticResource AbletonText}"
                              BorderBrush="{StaticResource AbletonBorder}"
                              FontSize="12" Margin="0,2,0,0"
                              ToolTip="AMD-AMF-Hardware-Encoder. auto = Backend waehlt den besten verfuegbaren AMF-Encoder. Kein CPU-Fallback."/>
                </StackPanel>

                <!-- L-N5: Bitrate Slider (4-50 Mbps, default 12) -->
                <StackPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="Bitrate" Style="{StaticResource ParamLabel}" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding BitrateMbps, StringFormat={}{0} Mbps}"
                                   Style="{StaticResource ParamValue}"
                                   Foreground="{StaticResource AbletonAccent}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Minimum="4" Maximum="50"
                            Value="{Binding BitrateMbps}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip="Video-Bitrate in Mbps (höher = bessere Qualität, größere Datei). Default 12 Mbps für 1080p."/>
                </StackPanel>
            </StackPanel>
        </md:Card>

        <!-- ══ Render Control Card ══ -->
        <md:Card DockPanel.Dock="Top" Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="RENDER CONTROL" Style="{StaticResource SectionHeader}"/>

                <!-- Buttons -->
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Command="{Binding StartRenderCommand}"
                                IsEnabled="{Binding IsRendering, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Background="{StaticResource AbletonAccent}"
                                Foreground="White"
                                Padding="12,6" Height="34"
                                ToolTip="Finales Video rendern (FFmpeg + AMF Encoding)">
                            <StackPanel Orientation="Horizontal">
                                <icon:PackIconMaterial Kind="Play" Width="14" Height="14"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Render starten" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelRenderCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource AbletonRed}"
                                Padding="12,6" Height="34" Margin="8,0,0,0"
                                ToolTip="Laufendes Rendering abbrechen"
                                Visibility="{Binding IsRendering, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <icon:PackIconMaterial Kind="Stop" Width="14" Height="14"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Abbrechen" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ClearRenderLogCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonTextDim}"
                            Padding="8,4" Height="30"
                            ToolTip="Render-Log leeren">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Broom" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Log leeren" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Progress Bar (Feature-1: zentriertes %) -->
                <controls:ProgressBarWithLabel Percent="{Binding RenderProgress}"
                                               Visibility="{Binding IsRendering, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Status + ETA -->
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding EtaText}"
                               Foreground="{StaticResource AbletonYellow}" FontSize="11"
                               FontFamily="Consolas"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </md:Card>

        <!-- ══ Render Log ══ -->
        <md:Card Style="{StaticResource AbletonCard}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                    <TextBlock Text="RENDER LOG" Style="{StaticResource SectionHeader}"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding RenderLogEntries.Count, StringFormat={}{0} Einträge}"
                               Foreground="{StaticResource AbletonTextDim}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Border Background="{StaticResource AbletonPanel}" Margin="1,0,1,1">
                    <ListBox ItemsSource="{Binding RenderLogEntries}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource AbletonTextDim}"
                             FontFamily="Consolas"
                             FontSize="11"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,3"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AbletonSurface}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </DockPanel>
        </md:Card>
    </DockPanel>
</UserControl>
