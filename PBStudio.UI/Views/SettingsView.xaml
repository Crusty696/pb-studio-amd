<UserControl x:Class="PBStudio.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="600" Margin="12"
                    HorizontalAlignment="Center" Width="600">

            <!-- ══ GPU Status Card ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="GPU STATUS" Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource AbletonAccent}"
                                    Padding="6,4" Height="28"
                                    ToolTip="GPU-Status aktualisieren&#x0a;• Was es macht: Fragt den aktuellen Hardware-Status deiner Grafikkarte über LibreHardwareMonitor ab.&#x0a;• Wozu es dient: Bringt Temperatur, belegten VRAM und Lüfterdaten live auf den neuesten Stand.&#x0a;• Wann &amp; wie nutzen: Nützlich bei langen Berechnungen, um zu sehen, ob deine Grafikkarte thermisch ausgelastet ist.">
                                <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14"/>
                            </Button>
                            <Button Command="{Binding CleanupGpuCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource AbletonYellow}"
                                    Padding="6,4" Height="28" Margin="4,0,0,0"
                                    ToolTip="VRAM aufräumen &amp; Cache leeren&#x0a;• Was es macht: Entlädt alle inaktiven KI-Modelle aus dem Grafikkartenspeicher (VRAM) und leert den Cache.&#x0a;• Wozu es dient: Gibt blockierten Speicher sofort wieder frei, um Platz für andere Anwendungen oder neue Modell-Tests zu schaffen.&#x0a;• Wann &amp; wie nutzen: Immer dann drücken, wenn du Grafik-Fehler vermutest oder vor dem Wechsel zu rechenintensiven Games.">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="Broom" Width="14" Height="14"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Cleanup" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- GPU Info Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- GPU Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GPU"
                                   Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GpuName}"
                                   Style="{StaticResource ParamValue}" Foreground="{StaticResource AbletonGreen}"
                                   Margin="0,0,0,6"/>

                        <!-- VRAM Total -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="VRAM Gesamt"
                                   Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                   Style="{StaticResource ParamValue}" Foreground="{StaticResource AbletonGreen}"
                                   ToolTip="Gesamter Grafikspeicher (VRAM)&#x0a;• Was es macht: Zeigt die Gesamtkapazität des dedizierten Speichers deiner Grafikkarte an.&#x0a;• Wozu es dient: Gibt den maximal verfügbaren Rahmen für alle System- und KI-Aufgaben vor.&#x0a;• Wann &amp; wie nutzen: Rein informativer Wert. Zeigt dir, über wie viel VRAM deine Hardware physikalisch verfügt.">
                            <Run Text="{Binding VramTotal, Mode=OneWay}"/><Run Text=" MB"/>
                        </TextBlock>

                        <!-- VRAM Used -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="VRAM Belegt"
                                   Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                                   Style="{StaticResource ParamValue}" Foreground="{StaticResource AbletonYellow}"
                                   ToolTip="Belegter Grafikspeicher (VRAM)&#x0a;• Was es macht: Zeigt an, wie viel Grafikspeicher momentan von Windows und allen aktiven Programmen belegt ist.&#x0a;• Wozu es dient: Hilft dir zu beurteilen, ob der Speicher knapp wird und ob eine Bereinigung sinnvoll ist.&#x0a;• Wann &amp; wie nutzen: Regelmäßig prüfen, um Engpässe und Ruckler frühzeitig zu erkennen.">
                            <Run Text="{Binding VramUsed, Mode=OneWay}"/><Run Text=" MB"/>
                        </TextBlock>

                        <!-- Temperature -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Temperatur"
                                   Style="{StaticResource ParamLabel}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                                   Style="{StaticResource ParamValue}" Foreground="{StaticResource AbletonGreen}">
                            <Run Text="{Binding Temperature, Mode=OneWay}"/><Run Text=" °C"/>
                        </TextBlock>

                        <!-- Driver Version -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Treiber"
                                   Style="{StaticResource ParamLabel}" Margin="0,0,0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Style="{StaticResource ParamValue}" Text="{Binding DriverVersion}"
                                   Foreground="{StaticResource AbletonText}" Margin="0,0,0,2"/>
                    </Grid>
                </StackPanel>
            </md:Card>

            <!-- ══ Hardware Configuration Card ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="HARDWARE KONFIGURATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                    <!-- VRAM Cap Slider -->
                    <StackPanel Margin="0,0,0,16">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="VRAM Limit" Style="{StaticResource ParamLabel}"/>
                            <TextBlock Text="{Binding VramLimitMb, StringFormat={}{0} MB}"
                                       Style="{StaticResource ParamValue}" Foreground="{StaticResource AbletonAccent}"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider Minimum="2048" Maximum="32768" TickFrequency="512"
                                Value="{Binding VramLimitMb}"
                                IsSnapToTickEnabled="True"
                                ToolTip="Maximales VRAM-Limit für PB Studio&#x0a;• Was es macht: Setzt eine harte Obergrenze fest, wie viel Grafikspeicher PB Studio maximal für KI-Modelle reservieren darf.&#x0a;• Wozu es dient: Schützt dein Windows-System und andere Apps davor, dass PB Studio den gesamten Grafikspeicher aufbraucht und das System einfriert.&#x0a;• Wann &amp; wie nutzen: Sollte in der Regel auf ca. 75-80% deines Gesamt-VRAMs eingestellt werden."/>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="Bestimmt wann der Arbiter Modelle auslagert oder Anfragen ablehnt."
                                       FontSize="10" Foreground="{StaticResource AbletonTextDim}"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="10"
                                       Foreground="{StaticResource AbletonTextDim}"
                                       ToolTip="Physikalisch gemeldeter VRAM&#x0a;• Was es macht: Zeigt die exakte Speichergröße an, die der Grafiktreiber dem Betriebssystem meldet.&#x0a;• Wozu es dient: Dient als Kontrollwert, ob deine Grafikkarte vom System korrekt erkannt wurde.&#x0a;• Wann &amp; wie nutzen: Nur zur Information und Fehlerdiagnose bei Hardware-Erkennungsproblemen.">
                                <Run Text="echt: "/><Run Text="{Binding VramTotal, Mode=OneWay, StringFormat={}{0} MB}"/>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>

                    <!-- Forced VRAM (env-var PB_STUDIO_FORCED_VRAM) -->
                    <StackPanel Margin="0,0,0,16">
                        <DockPanel Margin="0,0,0,4">
                            <CheckBox IsChecked="{Binding ForceVramEnabled}"
                                      Content="VRAM erzwingen (PB_STUDIO_FORCED_VRAM)"
                                      Foreground="{StaticResource AbletonText}" FontSize="11"
                                      ToolTip="VRAM-Simulation aktivieren&#x0a;• Was es macht: Aktiviert eine Testumgebung, in der eine bestimmte VRAM-Größe für PB Studio vorgetäuscht wird.&#x0a;• Wozu es dient: Ermöglicht Entwicklern zu simulieren, wie sich die App auf schwächeren oder stärkeren Grafikkarten verhält.&#x0a;• Wann &amp; wie nutzen: Nur für Entwicklungs- und Testzwecke aktivieren. Im Normalbetrieb ausgeschaltet lassen."/>
                            <TextBlock Text="{Binding ForcedVramMb, StringFormat={}{0} MB}"
                                       Style="{StaticResource ParamValue}" Foreground="{StaticResource AbletonYellow}"
                                       HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </DockPanel>
                        <Slider Minimum="2048" Maximum="32768" TickFrequency="512"
                                Value="{Binding ForcedVramMb}"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding ForceVramEnabled}"
                                ToolTip="Simulierte VRAM-Größe&#x0a;• Was es macht: Stellt die VRAM-Größe ein, die für den Testmodus simuliert werden soll.&#x0a;• Wozu es dient: Definiert die Speicherobergrenze für das Test-Szenario.&#x0a;• Wann &amp; wie nutzen: Nur aktiv, wenn 'VRAM erzwingen' aktiviert ist. Greift erst nach einem Neustart des Backend-Prozesses."/>
                        <TextBlock Text="Greift erst nach Backend-Restart. Nützlich für Tests auf kleineren GPUs."
                                   FontSize="10" Foreground="{StaticResource AbletonTextDim}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Command="{Binding SaveSettingsCommand}"
                            Background="{StaticResource AbletonAccent}" BorderThickness="0"
                            Height="32" Content="Einstellungen übernehmen">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </md:Card>

            <!-- ══ KI-Modus Card (Auto-Selection-Bias) ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="KI-MODUS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                    <TextBlock Text="Bestimmt welches Vision-Modell die App automatisch waehlt. Wirkt sich auf Captioning und kuenftige Audio/Pacing-Tracks aus."
                               FontSize="11" Foreground="{StaticResource AbletonTextDim}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Slider Speed / Balance / Quality -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Modus" Style="{StaticResource ParamLabel}"/>
                        <TextBlock Text="{Binding KiModeLabel}"
                                   Style="{StaticResource ParamValue}"
                                   Foreground="{StaticResource AbletonAccent}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Slider Minimum="0" Maximum="2" TickFrequency="1"
                            Value="{Binding KiModeIndex}"
                            IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            ToolTip="KI-Modus-Auswahl&#x0a;• Was es macht: Steuert die Balance zwischen Verarbeitungsgeschwindigkeit (Speed) und Analysegenauigkeit (Quality).&#x0a;• Wozu es dient: Passt die automatisch ausgewählten KI-Modelle an die Leistungsfähigkeit deines PCs an.&#x0a;• Wann &amp; wie nutzen: 'Speed' für schnelle Vorab-Entwürfe, 'Balance' für die meisten Rechner, 'Quality' für maximale Details bei starker Hardware."/>

                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SPEED"
                                   FontSize="10" Foreground="{StaticResource AbletonTextDim}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="BALANCE"
                                   FontSize="10" Foreground="{StaticResource AbletonTextDim}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="QUALITY"
                                   FontSize="10" Foreground="{StaticResource AbletonTextDim}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="{Binding KiModeDescription}"
                               FontSize="11" Foreground="{StaticResource AbletonText}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Border Background="{StaticResource AbletonPanel}"
                            BorderBrush="{StaticResource AbletonBorder}"
                            BorderThickness="1" CornerRadius="2"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="RobotOutline" Width="13" Height="13"
                                                   Foreground="{StaticResource AbletonAccent}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding KiModeAutoSelectionText}"
                                       FontSize="11"
                                       Foreground="{StaticResource AbletonTextDim}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </md:Card>

            <!-- ══ FFmpeg Configuration Card ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="FFMPEG KONFIGURATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                    <TextBlock Text="Pfad zur ffmpeg.exe (leer = PATH/Auto-Detect)"
                               Style="{StaticResource ParamLabel}" Margin="0,0,0,4"/>

                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0"
                                Command="{Binding BrowseFfmpegCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource AbletonAccent}"
                                Padding="8,4" Height="28"
                                ToolTip="FFmpeg-Pfad durchsuchen&#x0a;• Was es macht: Öffnet einen Windows-Dateidialog, um die ausführbare Datei 'ffmpeg.exe' manuell auszuwählen.&#x0a;• Wozu es dient: Ermöglicht das Verwenden einer benutzerdefinierten FFmpeg-Version, falls die automatische Erkennung fehlschlägt.&#x0a;• Wann &amp; wie nutzen: Nutzen, wenn du FFmpeg an einem benutzerdefinierten Ort installiert hast und die App es nicht findet.">
                            <StackPanel Orientation="Horizontal">
                                <icon:PackIconMaterial Kind="FolderOpen" Width="14" Height="14"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Browse" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0"
                                Command="{Binding ProbeFfmpegCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource AbletonGreen}"
                                Padding="8,4" Height="28"
                                ToolTip="FFmpeg-Kompatibilität prüfen&#x0a;• Was es macht: Führt einen kurzen Testaufruf aus, um zu überprüfen, ob FFmpeg unter dem angegebenen Pfad korrekt funktioniert.&#x0a;• Wozu es dient: Verifiziert die ordnungsgemäße Installation und gibt die erkannte FFmpeg-Versionsnummer aus.&#x0a;• Wann &amp; wie nutzen: Immer nach der manuellen Angabe oder Änderung des FFmpeg-Pfads anklicken.">
                            <StackPanel Orientation="Horizontal">
                                <icon:PackIconMaterial Kind="Check" Width="14" Height="14"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Probe" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{StaticResource AbletonText}"
                                 Background="{StaticResource AbletonPanel}"
                                 BorderBrush="{StaticResource AbletonBorder}"
                                 Height="28" VerticalContentAlignment="Center" Padding="6,2"
                                 ToolTip="FFmpeg-Pfad-Eingabe&#x0a;• Was es macht: Hier wird der vollständige Pfad zur ausführbaren Datei 'ffmpeg.exe' eingegeben.&#x0a;• Wozu es dient: FFmpeg ist das Herzstück für das Zusammenfügen und Rendern von Videos in PB Studio.&#x0a;• Wann &amp; wie nutzen: Leer lassen, um die Standard-Systemerkennung zu nutzen. Bei Problemen den absoluten Pfad manuell eintragen."/>
                    </DockPanel>

                    <!-- Inline Validation Error -->
                    <TextBlock Text="{Binding FfmpegPathError}"
                               Foreground="{StaticResource AbletonRed}"
                               FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                               Visibility="{Binding FfmpegPathError, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <!-- Probed Version -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding FfmpegVersion, Converter={StaticResource NullToVisibilityConverter}}">
                        <icon:PackIconMaterial Kind="CheckCircle" Width="12" Height="12"
                                               VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{StaticResource AbletonGreen}"/>
                        <TextBlock VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource AbletonGreen}">
                            <Run Text="Version: "/><Run Text="{Binding FfmpegVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Probe in progress indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding IsProbingFfmpeg, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Prüfe FFmpeg-Version..." FontSize="11"
                                   Foreground="{StaticResource AbletonTextDim}"/>
                    </StackPanel>
                </StackPanel>
            </md:Card>

            <!-- ══ Settings File Path (Info) ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="10" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{StaticResource AbletonTextDim}"/>
                    <TextBlock VerticalAlignment="Center" FontSize="10"
                               Foreground="{StaticResource AbletonTextDim}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SettingsFilePath}">
                        <Run Text="Settings-Datei: "/><Run Text="{Binding SettingsFilePath, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </md:Card>

            <!-- ══ Backend Status Card ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="BACKEND STATUS" Style="{StaticResource SectionHeader}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <!-- Status Dot -->
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource AbletonRed}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackendOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AbletonGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource AbletonText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Offline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackendOnline}" Value="True">
                                            <Setter Property="Text" Value="Online (Port 8765)"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                </StackPanel>
            </md:Card>

            <!-- ══ Info Card ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PB STUDIO AMD EDITION"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AbletonAccent}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Audio-reaktiver Video-Editor mit AMD GPU-Beschleunigung"
                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock Text="DirectML + AMF Encoding | .NET 9.0 + FastAPI"
                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"
                               HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </md:Card>

            <!-- ══ License Attribution (Plan Phase 6) ══ -->
            <md:Card Style="{StaticResource AbletonCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="LIZENZEN &amp; ATTRIBUTION" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                    <TextBlock Foreground="{StaticResource AbletonText}" Margin="0,0,0,4" TextWrapping="Wrap">
                        <Run Text="Audio-Embedding by " FontWeight="Bold"/>
                        <Run Text="LAION CLAP" Foreground="{StaticResource AbletonAccent}"/>
                        <Run Text=" (laion/larger_clap_music) — CC-BY-4.0"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="https://creativecommons.org/licenses/by/4.0/"/>

                    <TextBlock Foreground="{StaticResource AbletonText}" Margin="0,0,0,4" TextWrapping="Wrap">
                        <Run Text="Video-Embedding by " FontWeight="Bold"/>
                        <Run Text="Google SigLIP SO400M" Foreground="{StaticResource AbletonAccent}"/>
                        <Run Text=" (google/siglip-so400m-patch14-384) — Apache 2.0"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="https://www.apache.org/licenses/LICENSE-2.0"/>

                    <TextBlock Foreground="{StaticResource AbletonText}" Margin="0,0,0,4" TextWrapping="Wrap">
                        <Run Text="Hardware Encoding by " FontWeight="Bold"/>
                        <Run Text="FFmpeg" Foreground="{StaticResource AbletonAccent}"/>
                        <Run Text=" (LGPL/GPL, dynamisch verlinkt)"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource AbletonText}" Margin="0,0,0,4" TextWrapping="Wrap">
                        <Run Text="Stem-Separation by " FontWeight="Bold"/>
                        <Run Text="UVR-MDX-NET" Foreground="{StaticResource AbletonAccent}"/>
                        <Run Text=" — MIT"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Volle Lizenztexte: LICENSES.md im Projekt-Root."/>
                </StackPanel>
            </md:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
