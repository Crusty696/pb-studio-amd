<UserControl x:Class="PBStudio.UI.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:models="clr-namespace:PBStudio.UI.Models"
             xmlns:converters="clr-namespace:PBStudio.UI.Converters"
             Background="{StaticResource AbletonBg}">

    <UserControl.Resources>
        <converters:TimeToPixelConverter x:Key="TimeToPixelConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <DockPanel Margin="12">

        <!-- ══ Top Toolbar ══ -->
        <md:Card DockPanel.Dock="Top" Style="{StaticResource AbletonCard}" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding RefreshTimelineCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            ToolTip="Aktuelle Cut-Liste laden"
                            Padding="8,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Timeline laden" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0" Background="{StaticResource AbletonBorder}"/>
                    
                    <!-- Zoom Controls -->
                    <icon:PackIconMaterial Kind="MagnifyMinus" Width="14" Height="14" Foreground="{StaticResource AbletonTextDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider Width="120" Minimum="10" Maximum="500" Value="{Binding PixelsPerSecond}" 
                            VerticalAlignment="Center" ToolTip="Horizontaler Zoom (Pixel/Sekunde)"/>
                    <icon:PackIconMaterial Kind="MagnifyPlus" Width="14" Height="14" Foreground="{StaticResource AbletonTextDim}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <icon:PackIconMaterial Kind="ClockOutline" Width="12" Height="12" Foreground="{StaticResource AbletonTextDim}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Run Text="Dauer: "/><Run Text="{Binding TotalDuration, StringFormat={}{0:F1}s, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center">
                        <Run Text="{Binding TimelineEntries.Count, Mode=OneWay}"/><Run Text=" Clips"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </md:Card>

        <!-- ══ Preview + Details Panel (Fixed at Bottom) ══ -->
        <md:Card DockPanel.Dock="Bottom" Style="{StaticResource AbletonCard}" Padding="12" Margin="0,8,0,0">
            <Grid Height="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CLIP PREVIEW" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <Border Background="#FF111111" BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1" CornerRadius="4">
                        <Grid Height="200">
                            <MediaElement x:Name="PreviewPlayer" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          MediaOpened="PreviewPlayer_OnMediaOpened" MediaEnded="PreviewPlayer_OnMediaEnded" MediaFailed="PreviewPlayer_OnMediaFailed"/>
                            <TextBlock x:Name="PreviewEmptyText" Text="Wähle einen Timeline-Cut" Foreground="{StaticResource AbletonTextDim}" 
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="PlayPreview_Click" IsEnabled="{Binding CanPreviewSelectedClip}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,4,0">
                            <icon:PackIconMaterial Kind="Play" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="1" Click="PausePreview_Click" IsEnabled="{Binding CanPreviewSelectedClip}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,4,0">
                            <icon:PackIconMaterial Kind="Pause" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="2" Click="StopPreview_Click" IsEnabled="{Binding CanPreviewSelectedClip}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4">
                            <icon:PackIconMaterial Kind="Stop" Width="14" Height="14"/>
                        </Button>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewStatusText" Text="Kein Preview" Foreground="{StaticResource AbletonTextDim}" FontSize="10"/>
                            <TextBlock Text="{Binding SelectedPreviewRange, Mode=OneWay}" Foreground="{StaticResource AbletonTextDim}" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SELEKTIERTER CUT" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource AbletonText}" FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedClipName, Mode=OneWay}"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="ZEITRAUM" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedTimeRange, Mode=OneWay}" Foreground="{StaticResource AbletonGreen}" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CLIP-IN" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedClipStart, Mode=OneWay}" Foreground="{StaticResource AbletonYellow}" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="TRIGGER" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedTrigger, Mode=OneWay}" Foreground="{StaticResource AbletonAccent}"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="DATEI" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedFilePath, Mode=OneWay}" Foreground="{StaticResource AbletonTextDim}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </md:Card>

        <!-- ══ Main Timeline Container ══ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/> <!-- ListView height -->
                <RowDefinition Height="5"/>   <!-- Splitter -->
                <RowDefinition Height="*"/>   <!-- Interactive Timeline height -->
            </Grid.RowDefinitions>

            <!-- 1. List View (Summary) -->
            <md:Card Grid.Row="0" Style="{StaticResource AbletonCard}" Padding="0">
                <ListView ItemsSource="{Binding TimelineEntries}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AbletonText}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Clip" Width="180" DisplayMemberBinding="{Binding ClipName}"/>
                            <GridViewColumn Header="Zeitraum" Width="130" DisplayMemberBinding="{Binding TimeRangeText}"/>
                            <GridViewColumn Header="Trigger" Width="100" DisplayMemberBinding="{Binding TriggerType}"/>
                            <GridViewColumn Header="Dauer" Width="70" DisplayMemberBinding="{Binding Duration, StringFormat={}{0:F2}s}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </md:Card>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource AbletonBorder}" Margin="0,2"/>

            <!-- 2. INTERACTIVE POWER TIMELINE (Option C) -->
            <md:Card Grid.Row="2" Style="{StaticResource AbletonCard}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/> <!-- Ruler -->
                        <RowDefinition Height="*"/>  <!-- Tracks -->
                    </Grid.RowDefinitions>
                    
                    <!-- Timeline Ruler -->
                    <Border Grid.Row="0" Background="{StaticResource AbletonPanel}" BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,0,0,1">
                        <Canvas x:Name="RulerCanvas" Height="25" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Scrollable Track Area -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled">
                        <Grid Width="{Binding TimelineWidth}" Background="#111111" PreviewMouseDown="TimelineGrid_MouseDown">
                            
                            <!-- Waveform Layer (Background) -->
                            <ItemsControl ItemsSource="{Binding WaveformBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="X"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Height="{Binding Height}"
                                                   Fill="{StaticResource AbletonAccent}"
                                                   Opacity="0.15">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="Width"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Rectangle.Width>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Beat Markers Layer -->
                            <ItemsControl ItemsSource="{Binding BeatMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line Y1="0" Y2="500" Stroke="{StaticResource AbletonGreen}" StrokeThickness="0.5" Opacity="0.2" StrokeDashArray="2,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Onset Markers Layer -->
                            <ItemsControl ItemsSource="{Binding SnapMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line Y1="0" Y2="500" Stroke="{StaticResource AbletonAccent}" StrokeThickness="0.3" Opacity="0.1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Clip Items Layer -->
                            <ItemsControl x:Name="TimelineItemsControl" ItemsSource="{Binding TimelineEntries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="StartTime"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TimelineEntryModel}">
                                        <Border x:Name="ClipBorder" 
                                                Height="80" 
                                                Margin="0,10"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource AbletonAccent}"
                                                Background="{StaticResource AbletonPanel}"
                                                ToolTip="{Binding ClipName}"
                                                Cursor="Hand"
                                                PreviewMouseDown="Clip_MouseDown"
                                                PreviewMouseMove="Clip_MouseMove"
                                                PreviewMouseUp="Clip_MouseUp">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="SnapStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="Snapped">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="ClipBorder" 
                                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                            To="White" Duration="0:0:0.1"/>
                                                            <DoubleAnimation Storyboard.TargetName="ClipBorder"
                                                                             Storyboard.TargetProperty="BorderThickness"
                                                                             To="2" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="Duration"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="4"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding ClipName}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource AbletonText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="4"/>

                                                <!-- Plan Phase 5: Confidence-Balken (rot..grün aus brain_final_score) -->
                                                <Rectangle Grid.Row="1"
                                                           Height="4"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Bottom"
                                                           Fill="{Binding BrainConfidence, Converter={StaticResource ConfidenceToBrushConverter}}"
                                                           ToolTip="Brain-Confidence (rot=unsicher, grün=sicher)"/>

                                                <!-- Drag Handles for Trimming -->
                                                <Rectangle Grid.Row="0" Grid.RowSpan="2" Width="4" HorizontalAlignment="Left" Fill="{StaticResource AbletonAccent}" Cursor="SizeWE" Opacity="0.5"/>
                                                <Rectangle Grid.Row="0" Grid.RowSpan="2" Width="4" HorizontalAlignment="Right" Fill="{StaticResource AbletonAccent}" Cursor="SizeWE" Opacity="0.5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Playhead (Current Position) -->
                            <Canvas HorizontalAlignment="Left" Width="{Binding TimelineWidth}">
                                <Border Width="2" Background="{StaticResource AbletonGreen}" Height="500">
                                    <Border.RenderTransform>
                                        <TranslateTransform>
                                            <TranslateTransform.X>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="SelectedTimelinePosition"/>
                                                    <Binding Path="PixelsPerSecond"/>
                                                </MultiBinding>
                                            </TranslateTransform.X>
                                        </TranslateTransform>
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </md:Card>
        </Grid>
    </DockPanel>
</UserControl>
