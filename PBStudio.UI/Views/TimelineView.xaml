<UserControl x:Class="PBStudio.UI.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:models="clr-namespace:PBStudio.UI.Models"
             xmlns:converters="clr-namespace:PBStudio.UI.Converters"
             xmlns:controls="clr-namespace:PBStudio.UI.Controls"
             Background="{StaticResource AbletonBg}">

    <UserControl.Resources>
        <converters:TimeToPixelConverter x:Key="TimeToPixelConverter"/>
        <converters:StatusTextToBrushConverter x:Key="StatusTextToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="AbletonCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">

        <!-- ══ Top Toolbar ══ -->
        <md:Card DockPanel.Dock="Top" Style="{StaticResource AbletonCard}" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding RefreshTimelineCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            ToolTip="Timeline laden&#x0a;• Was es macht: Lädt die aktuelle Cut-Liste des Smart Directors neu auf die Zeitachse.&#x0a;• Wozu es dient: Aktualisiert die visuelle Darstellung, falls der Smart Director ein neues Video generiert hat oder externe Änderungen vorliegen.&#x0a;• Wann &amp; wie nutzen: Nach jeder neuen Generierung oder manuellen Anpassung anklicken, um den aktuellsten Stand anzuzeigen."
                            Padding="8,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Timeline laden" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PreviousCutCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonText}"
                            ToolTip="Vorherigen Cut auswählen"
                            Padding="8,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ChevronLeft" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Zurück" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NextCutCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonText}"
                            ToolTip="Nächsten Cut auswählen"
                            Padding="8,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Weiter" VerticalAlignment="Center" FontSize="12"/>
                            <icon:PackIconMaterial Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0" Background="{StaticResource AbletonBorder}"/>
                    
                    <!-- Zoom Controls -->
                    <icon:PackIconMaterial Kind="MagnifyMinus" Width="14" Height="14" Foreground="{StaticResource AbletonTextDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider Width="120" Minimum="10" Maximum="500" Value="{Binding PixelsPerSecond}"
                            VerticalAlignment="Center" ToolTip="Horizontaler Zoom&#x0a;• Was es macht: Vergrößert oder verkleinert die zeitliche Darstellung der Timeline.&#x0a;• Wozu es dient: Ermöglicht das präzise Trimmen und Betrachten einzelner Takte und Videoschnitte.&#x0a;• Wann &amp; wie nutzen: Nach links schieben für eine Gesamtübersicht, nach rechts schieben für detailgenaues Arbeiten an Taktgrenzen."/>
                    <icon:PackIconMaterial Kind="MagnifyPlus" Width="14" Height="14" Foreground="{StaticResource AbletonTextDim}" VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0" Background="{StaticResource AbletonBorder}"/>

                    <!-- Show Waveform/Beatgrid Toggles -->
                    <CheckBox IsChecked="{Binding ShowWaveform}"
                              Style="{StaticResource AbletonCheckBox}"
                              ToolTip="Wellenform anzeigen&#x0a;• Was es macht: Blendet die visuelle Lautstärkekurve (Wellenform) der geladenen Musikspur ein oder aus.&#x0a;• Wozu es dient: Hilft dabei, Breaks, Drops und rhythmische Wechsel in der Musik visuell zu lokalisieren.&#x0a;• Wann &amp; wie nutzen: Aktiviert lassen, um Schnitte präzise auf Audio-Ereignisse abzustimmen."
                              Content="Wellenform"/>
                              
                    <CheckBox IsChecked="{Binding ShowBeatgrid}"
                              Style="{StaticResource AbletonCheckBox}"
                              ToolTip="Beatgrid anzeigen&#x0a;• Was es macht: Zeigt ein regelmäßiges Liniennetz auf Takt-Basis über der Audiospur an.&#x0a;• Wozu es dient: Macht die einzelnen Musik-Beats sichtbar, um Schnitte perfekt synchron zur Musik auszurichten.&#x0a;• Wann &amp; wie nutzen: Einschalten für rhythmisch exakte Videomontagen und taktsynchrones Cutten."
                              Content="Beatgrid"
                              Margin="10,0,6,0"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0" Background="{StaticResource AbletonBorder}"/>

                    <!-- Preview rendern (POST /pacing/preview) -->
                    <TextBlock Text="ab" Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="44" Height="22" Padding="4,2"
                             Text="{Binding PreviewStartSec, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"
                             Background="{StaticResource AbletonSurface}"
                             Foreground="{StaticResource AbletonText}"
                             BorderBrush="{StaticResource AbletonBorder}"
                             VerticalContentAlignment="Center"
                             ToolTip="Vorschau-Startsekunde&#x0a;• Was es macht: Bestimmt die genaue Sekunde im Mix, ab der das gerenderte Vorschau-Video starten soll.&#x0a;• Wozu es dient: Ermöglicht das gezielte Testen von Übergängen oder Drops an bestimmten Stellen.&#x0a;• Wann &amp; wie nutzen: Trag hier z.B. die Zeit kurz vor einem Break oder Drop ein, um nur diesen Übergang zu prüfen."/>
                    <TextBlock Text="s · " Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <TextBlock Text="Dauer" Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="44" Height="22" Padding="4,2"
                             Text="{Binding PreviewDurationSec, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}"
                             Background="{StaticResource AbletonSurface}"
                             Foreground="{StaticResource AbletonText}"
                             BorderBrush="{StaticResource AbletonBorder}"
                             VerticalContentAlignment="Center"
                             ToolTip="Vorschau-Dauer&#x0a;• Was es macht: Definiert die Länge des zu generierenden Vorschau-Videos in Sekunden.&#x0a;• Wozu es dient: Spart Rechenzeit und VRAM, indem nur ein kurzer Ausschnitt statt des gesamten Mixes gerendert wird.&#x0a;• Wann &amp; wie nutzen: Typischerweise auf 10 bis 30 Sekunden einstellen. Längere Vorschauen dauern beim Rendern entsprechend länger."/>
                    <TextBlock Text="s" Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <Button Command="{Binding GeneratePreviewCommand}"
                            IsEnabled="{Binding IsGeneratingPreview, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            ToolTip="Vorschau-Video rendern&#x0a;• Was es macht: Erstellt ein temporäres Vorschau-Video in kleiner Auflösung (640×360) für den gewählten Zeitbereich.&#x0a;• Wozu es dient: Ermöglicht eine flüssige Echtzeit-Vorschau der generierten Videomontage inklusive Musik.&#x0a;• Wann &amp; wie nutzen: Klicken nach dem Ändern von Pacing-Gewichten oder Schnitten, um das Endergebnis visuell zu bewerten."
                            Padding="8,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="MovieOpenPlay" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Preview rendern" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar Width="40" Height="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AbletonAccent}"
                                 Background="Transparent"
                                 Visibility="{Binding IsGeneratingPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Audit-Fix 2026-07-10 (Sweep-Finding HIGH-12): StatusText war vorher
                         an kein UI-Element gebunden - Refresh-Fehler blieben unsichtbar. -->
                    <TextBox Text="{Binding StatusText, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding StatusText, Converter={StaticResource StatusTextToBrushConverter}}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding PreviewStatus}"
                               Foreground="{StaticResource AbletonAccent}"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <icon:PackIconMaterial Kind="ClockOutline" Width="12" Height="12" Foreground="{StaticResource AbletonTextDim}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Run Text="Dauer: "/><Run Text="{Binding TotalDuration, StringFormat={}{0:F1}s, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11" VerticalAlignment="Center">
                        <Run Text="{Binding TimelineEntries.Count, Mode=OneWay}"/><Run Text=" Clips"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </md:Card>

        <!-- ══ Motion-Curve Sparkline (Audit L-M5) ══
             Konsument fuer GET /video/motion/{id}. Zeigt motion_curve des aktuell
             selektierten Timeline-Entries als kompakte Bar-Sparkline (Hoehe 36px).
             Visible nur wenn MotionCurve != null (i.e. Clip ist analysiert und hat curve). -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}"
                BorderThickness="0,1,0,1"
                Height="36"
                Margin="0,4,0,0"
                Visibility="{Binding MotionCurve, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <TextBlock Text="MOTION"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AbletonTextDim}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="6,2,0,0"/>
                <ItemsControl ItemsSource="{Binding MotionCurve}"
                              Margin="60,12,6,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Fill="{StaticResource AbletonAccent}"
                                       Width="2"
                                       Margin="0.5,0"
                                       VerticalAlignment="Bottom"
                                       Height="{Binding Converter={StaticResource MotionToHeightConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ══ Preview + Details Panel (Fixed at Bottom) ══ -->
        <md:Card DockPanel.Dock="Bottom" Style="{StaticResource AbletonCard}" Padding="12" Margin="0,8,0,0">
            <Grid Height="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CLIP PREVIEW" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <Border Background="#FF111111" BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1" CornerRadius="4">
                        <Grid Height="200">
                            <MediaElement x:Name="PreviewPlayer" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          MediaOpened="PreviewPlayer_OnMediaOpened" MediaEnded="PreviewPlayer_OnMediaEnded" MediaFailed="PreviewPlayer_OnMediaFailed"/>
                            <TextBlock x:Name="PreviewEmptyText" Text="Wähle einen Timeline-Cut" Foreground="{StaticResource AbletonTextDim}" 
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="PlayPreview_Click" IsEnabled="{Binding CanPreviewSelectedClip}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,4,0">
                            <icon:PackIconMaterial Kind="Play" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="1" Click="PausePreview_Click" IsEnabled="{Binding CanPreviewSelectedClip}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,4,0">
                            <icon:PackIconMaterial Kind="Pause" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="2" Click="StopPreview_Click" IsEnabled="{Binding CanPreviewSelectedClip}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4">
                            <icon:PackIconMaterial Kind="Stop" Width="14" Height="14"/>
                        </Button>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewStatusText" Text="Kein Preview" Foreground="{StaticResource AbletonTextDim}" FontSize="10"/>
                            <TextBlock Text="{Binding SelectedPreviewRange, Mode=OneWay}" Foreground="{StaticResource AbletonTextDim}" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SELEKTIERTER CUT" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource AbletonText}" FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedClipName, Mode=OneWay}"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="ZEITRAUM" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedTimeRange, Mode=OneWay}" Foreground="{StaticResource AbletonGreen}" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CLIP-IN" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedClipStart, Mode=OneWay}" Foreground="{StaticResource AbletonYellow}" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="TRIGGER" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedTrigger, Mode=OneWay}" Foreground="{StaticResource AbletonAccent}"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="DATEI" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBox Text="{Binding SelectedFilePath, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource AbletonTextDim}"
                                             FontSize="10"
                                             TextWrapping="Wrap"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBox Text="{Binding SelectedEvidence, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource AbletonTextDim}"
                                     TextWrapping="Wrap"
                                     FontSize="10"
                                     Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </md:Card>

        <!-- ══ Main Timeline Container — V1 (Video) + A1 (Audio) Lanes ══ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/> <!-- Summary ListView -->
                <RowDefinition Height="5"/>   <!-- Splitter -->
                <RowDefinition Height="*"/>   <!-- Lanes -->
            </Grid.RowDefinitions>

            <!-- Summary ListView (unchanged) -->
            <md:Card Grid.Row="0" Style="{StaticResource AbletonCard}" Padding="0">
                <ListView ItemsSource="{Binding TimelineEntries}" SelectedItem="{Binding SelectedEntry}"
                          Background="Transparent" BorderThickness="0" Foreground="{StaticResource AbletonText}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Clip" Width="180" DisplayMemberBinding="{Binding ClipName}"/>
                            <GridViewColumn Header="Zeitraum" Width="130" DisplayMemberBinding="{Binding TimeRangeText}"/>
                            <GridViewColumn Header="Trigger" Width="100" DisplayMemberBinding="{Binding TriggerType}"/>
                            <GridViewColumn Header="Dauer" Width="70" DisplayMemberBinding="{Binding Duration, StringFormat={}{0:F2}s}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </md:Card>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource AbletonBorder}" Margin="0,2"/>

            <!-- Lanes container -->
            <md:Card Grid.Row="2" Style="{StaticResource AbletonCard}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>  <!-- Track headers -->
                        <ColumnDefinition Width="*"/>   <!-- Scrollable lanes -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>  <!-- Ruler -->
                        <RowDefinition Height="110"/> <!-- V1 -->
                        <RowDefinition Height="80"/>  <!-- A1 -->
                    </Grid.RowDefinitions>

                    <!-- Track headers (fixed left column) -->
                    <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource AbletonPanel}"
                            BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,0,1,1"/>
                    <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource AbletonPanel}"
                            BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,0,1,1">
                        <TextBlock Text="V1" Foreground="{StaticResource AbletonText}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>
                    <Border Grid.Column="0" Grid.Row="2" Background="{StaticResource AbletonPanel}"
                            BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,0,1,0">
                        <TextBlock Text="A1" Foreground="{StaticResource AbletonText}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <!-- Ruler -->
                    <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource AbletonPanel}"
                            BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,0,0,1">
                        <Canvas x:Name="RulerCanvas" Height="25" Background="Transparent" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Single horizontal ScrollViewer spanning both lanes -->
                    <ScrollViewer Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                                  x:Name="LanesScrollViewer"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="True"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <Grid Width="{Binding TimelineWidth}" Background="#111111"
                              PreviewMouseDown="TimelineGrid_MouseDown">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="110"/>  <!-- V1 -->
                                <RowDefinition Height="80"/>   <!-- A1 -->
                            </Grid.RowDefinitions>

                            <!-- ══════════════════════════════════════════════════════════ -->
                            <!-- V1 LANE: Video clips with thumbnail strips                 -->
                            <!-- ══════════════════════════════════════════════════════════ -->
                            <Border Grid.Row="0" Background="#FF1A1A1A"
                                    BorderBrush="{StaticResource AbletonBorder}" BorderThickness="0,0,0,1"/>

                            <!-- Song-segment background (only inside V1) -->
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding SongSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="StartTime"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="110" Opacity="0.10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Label}" Value="chorus">
                                                            <Setter Property="Background" Value="{StaticResource AbletonAccent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Label}" Value="verse">
                                                            <Setter Property="Background" Value="{StaticResource AbletonBlue}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Background" Value="{StaticResource AbletonBorder}"/>
                                                </Style>
                                            </Border.Style>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="Duration"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <!-- #14 (2026-05-20): Segment-Label im SongSegment-Border. -->
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{StaticResource AbletonText}"
                                                       FontSize="9"
                                                       Margin="4,2,0,0"
                                                       VerticalAlignment="Top"
                                                       Opacity="0.85"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- #12 (2026-05-20): DepthRenderer SpectralPoints overlay re-added.
                                 Cyan spectral-centroid line in V1-Lane (50px high, top-aligned).
                                 Data via SpectralPoints ObservableCollection, populated by
                                 TimelineViewModel.UpdateSpectralPoints(). -->
                            <controls:DepthRenderer Grid.Row="0"
                                                    Points="{Binding SpectralPoints}"
                                                    PixelsPerSecond="{Binding PixelsPerSecond}"
                                                    LineBrush="Cyan"
                                                    Opacity="0.3"
                                                    VerticalAlignment="Top"
                                                    Height="50"
                                                    Margin="0,5,0,0"
                                                    IsHitTestVisible="False"/>

                            <!-- Video clips -->
                            <ItemsControl x:Name="TimelineItemsControl" Grid.Row="0"
                                          ItemsSource="{Binding TimelineEntries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="StartTime"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TimelineEntryModel}">
                                        <Border x:Name="ClipBorder"
                                                Height="100" Margin="0,5"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource AbletonAccent}"
                                                Background="#FF2A2A2A"
                                                ClipToBounds="True"
                                                ToolTip="{Binding ClipName}"
                                                Cursor="Hand"
                                                PreviewMouseDown="Clip_MouseDown"
                                                PreviewMouseMove="Clip_MouseMove"
                                                PreviewMouseUp="Clip_MouseUp">
                                            <!-- #15 (2026-05-20): VisualStateManager re-added — MouseOver Opacity-Fade,
                                                 Selected Yellow-Border, Snapped White-Border (Drag-Feedback).
                                                 States werden von TimelineView.xaml.cs gesetzt (VisualStateManager.GoToElementState). -->
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="InteractionStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ClipBorder"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.9" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="ClipBorder"
                                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                            To="{StaticResource AbletonYellowColor}" Duration="0:0:0.1"/>
                                                            <DoubleAnimation Storyboard.TargetName="ClipBorder"
                                                                             Storyboard.TargetProperty="BorderThickness"
                                                                             To="2" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                                <VisualStateGroup x:Name="SnapStates">
                                                    <VisualState x:Name="NormalSnap"/>
                                                    <VisualState x:Name="Snapped">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="ClipBorder"
                                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                            To="White" Duration="0:0:0.1"/>
                                                            <DoubleAnimation Storyboard.TargetName="ClipBorder"
                                                                             Storyboard.TargetProperty="BorderThickness"
                                                                             To="3" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="Duration"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="60"/> <!-- Thumbnail strip -->
                                                    <RowDefinition Height="*"/>  <!-- Mini waveform -->
                                                    <RowDefinition Height="14"/> <!-- Name -->
                                                    <RowDefinition Height="4"/>  <!-- Confidence bar -->
                                                </Grid.RowDefinitions>

                                                <!-- Thumbnail strip (premiere-style) -->
                                                <ItemsControl Grid.Row="0" ItemsSource="{Binding ThumbnailFrames}"
                                                              ClipToBounds="True">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Per-clip mini waveform -->
                                                <Path Grid.Row="1" Stroke="{StaticResource AbletonBlue}"
                                                      StrokeThickness="1" Opacity="0.85" SnapsToDevicePixels="True">
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource PeaksToWaveformGeometryConverter}">
                                                            <Binding Path="AudioPeaks"/>
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>

                                                <TextBlock Grid.Row="2" Text="{Binding ClipName}"
                                                           FontSize="10" Foreground="{StaticResource AbletonText}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="4,0"/>

                                                <Rectangle Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                                                           Fill="{Binding BrainConfidence, Converter={StaticResource ConfidenceToBrushConverter}}"
                                                           ToolTipService.InitialShowDelay="450"
                                                           ToolTipService.ShowDuration="20000"
                                                           ToolTipOpening="ConfidenceBar_ToolTipOpening">
                                                    <Rectangle.ToolTip>
                                                        <ToolTip MaxWidth="320">
                                                            <TextBlock Text="{Binding PlacementTarget.DataContext.BrainExplainTooltip, RelativeSource={RelativeSource AncestorType=ToolTip}, TargetNullValue='Brain-Confidence — hover fuer Details'}"
                                                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                                        </ToolTip>
                                                    </Rectangle.ToolTip>
                                                </Rectangle>

                                                <!-- Trim handles -->
                                                <Rectangle Grid.Row="0" Grid.RowSpan="4" Width="4"
                                                           HorizontalAlignment="Left" Fill="{StaticResource AbletonAccent}"
                                                           Cursor="SizeWE" Opacity="0.5"/>
                                                <Rectangle Grid.Row="0" Grid.RowSpan="4" Width="4"
                                                           HorizontalAlignment="Right" Fill="{StaticResource AbletonAccent}"
                                                           Cursor="SizeWE" Opacity="0.5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ══════════════════════════════════════════════════════════ -->
                            <!-- A1 LANE: Music waveform + beat markers                     -->
                            <!-- ══════════════════════════════════════════════════════════ -->
                            <Border Grid.Row="1" Background="#FF141414"/>

                            <!-- Audio waveform (High-Performance Direct Waveform Drawing) -->
                            <controls:WaveformRenderer Grid.Row="1"
                                                       WaveformBars="{Binding WaveformBars}"
                                                       PixelsPerSecond="{Binding PixelsPerSecond}"
                                                       FillBrush="{StaticResource AbletonBlue}"
                                                       IsHitTestVisible="False"
                                                       Height="80"
                                                       VerticalAlignment="Stretch"
                                                       Visibility="{Binding ShowWaveform, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Song-segment background (mirrored inside A1 for Phrase Coloring) -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SongSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="StartTime"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="80" Opacity="0.12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Label}" Value="chorus">
                                                            <Setter Property="Background" Value="{StaticResource AbletonAccent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Label}" Value="verse">
                                                            <Setter Property="Background" Value="{StaticResource AbletonBlue}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Label}" Value="intro">
                                                            <Setter Property="Background" Value="{StaticResource AbletonTextDim}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Label}" Value="outro">
                                                            <Setter Property="Background" Value="{StaticResource AbletonTextDim}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Label}" Value="break">
                                                            <Setter Property="Background" Value="{StaticResource AbletonYellow}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Label}" Value="bridge">
                                                            <Setter Property="Background" Value="{StaticResource AbletonYellow}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Background" Value="{StaticResource AbletonBorder}"/>
                                                </Style>
                                            </Border.Style>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="Duration"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{StaticResource AbletonText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="6,8,0,0"
                                                       VerticalAlignment="Top"
                                                       Opacity="0.3"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- DJ-Style Beatgrid on A1 Lane (Rekordbox / Traktor) -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding UIBeatMarkers}"
                                         Visibility="{Binding ShowBeatgrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="Time"/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:BeatMarkerViewModel}">
                                        <Grid Height="80" ClipToBounds="False" IsHitTestVisible="False">
                                            <!-- Standard Beat: Dünne, eisblaue, halbtransparente Linie -->
                                            <Line X1="0" Y1="0" X2="0" Y2="80"
                                                  Stroke="#FF00D2FF" StrokeThickness="0.6" Opacity="0.35"
                                                  x:Name="BeatLine"/>
                                            
                                            <!-- Downbeat: Taktnummer als edles Badge -->
                                            <Border x:Name="DownbeatPanel" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                    Margin="-15,2,0,0" Padding="4,2" CornerRadius="2"
                                                    Background="#CC111111" BorderBrush="#FFFF3B30" BorderThickness="1"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="{Binding Label, StringFormat='BAR {0}'}"
                                                           Foreground="White" FontSize="8" FontWeight="SemiBold"
                                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDownbeat}" Value="True">
                                                <Setter TargetName="BeatLine" Property="Stroke" Value="#FFFF3B30"/>
                                                <Setter TargetName="BeatLine" Property="StrokeThickness" Value="1.4"/>
                                                <Setter TargetName="BeatLine" Property="Opacity" Value="0.85"/>
                                                <Setter TargetName="DownbeatPanel" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- #13 (2026-05-20): SnapMarkers (Onset-Lines) re-added.
                                 Cyan vertical lines parallel zu BeatMarkers, dünner + niedrigere Opacity. -->
                            <ItemsControl Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding SnapMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" VerticalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line Y1="0" Y2="500" Stroke="Cyan"
                                              StrokeThickness="0.3" Opacity="0.10"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Playhead -->
                            <Canvas Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Left"
                                    Width="{Binding TimelineWidth}">
                                <Border Width="2" Background="{StaticResource AbletonGreen}" Height="500">
                                    <Border.RenderTransform>
                                        <TranslateTransform>
                                            <TranslateTransform.X>
                                                <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                    <Binding Path="SelectedTimelinePosition"/>
                                                    <Binding Path="PixelsPerSecond"/>
                                                </MultiBinding>
                                            </TranslateTransform.X>
                                        </TranslateTransform>
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>

                            <!-- Snap line overlay -->
                            <Canvas Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Left"
                                    Width="{Binding TimelineWidth}">
                                <Border x:Name="SnapLine" Width="1" Background="Cyan" Height="500" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SnapLineTransform"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </md:Card>
        </Grid>
    </DockPanel>
</UserControl>
