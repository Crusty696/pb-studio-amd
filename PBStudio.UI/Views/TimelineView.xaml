<UserControl x:Class="PBStudio.UI.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}">

    <DockPanel Margin="12">

        <!-- ══ Top Toolbar ══ -->
        <md:Card DockPanel.Dock="Top" Style="{StaticResource AbletonCard}" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <Button Command="{Binding RefreshTimelineCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{StaticResource AbletonAccent}"
                        ToolTip="Aktuelle Cut-Liste als Timeline vom Backend laden"
                        Padding="8,4" Height="30">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               RenderTransformOrigin="0.5,0.5">
                            <icon:PackIconMaterial.Style>
                                <Style TargetType="icon:PackIconMaterial">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </icon:PackIconMaterial.Style>
                            <icon:PackIconMaterial.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </icon:PackIconMaterial.RenderTransform>
                        </icon:PackIconMaterial>
                        <TextBlock Text="Timeline laden" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <icon:PackIconMaterial Kind="ClockOutline" Width="12" Height="12"
                                           Foreground="{StaticResource AbletonTextDim}" Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,14,0">
                        <Run Text="Dauer: "/><Run Text="{Binding TotalDuration, Mode=OneWay}"/>
                    </TextBlock>

                    <icon:PackIconMaterial Kind="FilmstripBoxMultiple" Width="12" Height="12"
                                           Foreground="{StaticResource AbletonTextDim}" Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource AbletonTextDim}" FontSize="11"
                               VerticalAlignment="Center">
                        <Run Text="{Binding TimelineEntries.Count, Mode=OneWay}"/><Run Text=" Clips"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </md:Card>

        <!-- Loading indicator -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2"
                     Foreground="{StaticResource AbletonAccent}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Margin="0,0,0,4"/>

        <!-- ══ Status Bar ══ -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                   Foreground="{StaticResource AbletonTextDim}" FontSize="11"
                   Margin="4,6,0,0"/>

        <!-- ══ Main Timeline List ══ -->
        <md:Card Style="{StaticResource AbletonCard}" Padding="0">
            <ListView ItemsSource="{Binding TimelineEntries}"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource AbletonText}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="2,1"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <!-- Clip Name -->
                        <GridViewColumn Header="Clip" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ClipName}" FontSize="12"
                                               Foreground="{StaticResource AbletonText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Time Range -->
                        <GridViewColumn Header="Zeitraum" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimeRangeText}" FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource AbletonGreen}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Duration -->
                        <GridViewColumn Header="Dauer" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Duration}" FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource AbletonTextDim}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Trigger Type -->
                        <GridViewColumn Header="Trigger" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AbletonPanel}"
                                            CornerRadius="2" Padding="6,2">
                                        <TextBlock Text="{Binding TriggerType}" FontSize="11"
                                                   Foreground="{StaticResource AbletonYellow}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Trigger Strength -->
                        <GridViewColumn Header="Stärke" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="Trigger-Stärke: wie stark der Audio-Event den Schnitt ausgelöst hat">
                                        <ProgressBar Value="{Binding TriggerStrength, Mode=OneWay}"
                                                     Minimum="0" Maximum="1"
                                                     Height="4" Width="70"
                                                     Foreground="{StaticResource AbletonAccent}"
                                                     Background="{StaticResource AbletonPanel}"
                                                     BorderThickness="0"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- File Path -->
                        <GridViewColumn Header="Datei" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FilePath}" FontSize="11"
                                               Foreground="{StaticResource AbletonTextDim}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </md:Card>
    </DockPanel>
</UserControl>