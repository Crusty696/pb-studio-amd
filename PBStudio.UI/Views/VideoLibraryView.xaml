<UserControl x:Class="PBStudio.UI.Views.VideoLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             Background="{StaticResource AbletonBg}">

    <UserControl.Resources>
        <!-- Flat toolbar button -->
        <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AbletonAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Video card in grid -->
        <Style x:Key="VideoThumbCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AbletonSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AbletonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Transparent ListBox item container -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent"
                                CornerRadius="2" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#30FF764D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top Toolbar ── -->
        <Border Grid.Row="0" Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1"
                CornerRadius="2" Padding="4,2" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding LoadClipsCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Video-Liste vom Backend neu laden">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Aktualisieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <Button Command="{Binding AnalyzeSelectedCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Szenen und Bewegung des ausgewählten Clips analysieren">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Magnify" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <Button Command="{Binding AnalyzeAllCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Alle Clips analysieren (Scene-Detection + Motion) – dauert länger">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlaylistCheck" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Alle analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Thumbnail loading indicator -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsLoadingThumbnails, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                 Foreground="{StaticResource AbletonAccent}"
                                 Background="{StaticResource AbletonBorder}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Thumbnails…" FontSize="11"
                               Foreground="{StaticResource AbletonTextDim}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Thumbnail Grid ── -->
        <ListBox Grid.Row="1" ItemsSource="{Binding VideoClips}"
                 SelectedItem="{Binding SelectedClip}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource VideoThumbCard}">
                        <StackPanel>
                            <!-- Thumbnail area -->
                            <Border Height="112" CornerRadius="2,2,0,0" ClipToBounds="True">
                                <Grid>
                                    <!-- Dark fallback background -->
                                    <Border Background="#2A2A2A"/>

                                    <!-- Actual thumbnail image -->
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>

                                    <!-- Fallback icon when no thumbnail -->
                                    <icon:PackIconMaterial Kind="Video" Width="28" Height="28"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#444"
                                                           Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Clip info -->
                            <StackPanel Margin="8,6,8,8">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource AbletonText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding DurationText}"
                                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                                    <TextBlock Text="  |  "
                                               Foreground="{StaticResource AbletonBorder}" FontSize="11"/>
                                    <TextBlock Text="{Binding ResolutionText}"
                                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="2" Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1"
                CornerRadius="2" Padding="10,6" Margin="0,12,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="180" Height="4"
                             Value="{Binding AnalyzeAllProgress}" Margin="0,0,12,0"
                             Foreground="{StaticResource AbletonAccent}"
                             Background="{StaticResource AbletonBorder}"
                             Visibility="{Binding IsAnalyzingAll, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ProgressBar DockPanel.Dock="Left" Width="80" Height="4"
                             IsIndeterminate="True" Margin="0,0,12,0"
                             Foreground="{StaticResource AbletonYellow}"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AbletonTextDim}"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>