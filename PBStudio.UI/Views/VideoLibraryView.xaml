<UserControl x:Class="PBStudio.UI.Views.VideoLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:models="clr-namespace:PBStudio.UI.Models"
             xmlns:converters="clr-namespace:PBStudio.UI.Converters"
             xmlns:controls="clr-namespace:PBStudio.UI.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{StaticResource AbletonBg}"
             AutomationProperties.Name="Video-Bibliothek"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.InputBindings>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportVideosCommand}"/>
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding ImportFolderCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AnalyzeSelectedCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control+Shift" Command="{Binding AnalyzeAllCommand}"/>
        <KeyBinding Key="M" Modifiers="Alt" Command="{Binding AnalyzeMarkedCommand}"/>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllVideosCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="Delete" Modifiers="Control+Shift" Command="{Binding DeleteAllVideosCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:TimeToPixelConverter x:Key="TimeToPixelConverter"/>
        <!-- AP3.3: typisierter Double statt String-Source "100.0" (String wurde vom
             TimeToPixelConverter zu 0.0 verworfen — Balken war permanent 0px breit) -->
        <sys:Double x:Key="SceneBarScale">100.0</sys:Double>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Lokale Style-Definition: AbletonCheckBox wird sonst nur in Director/TimelineView
             deklariert; ohne diese Definition crasht der XAML-Load (StaticResource not found). -->
        <Style x:Key="AbletonCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AbletonText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource AbletonToolbar}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Command="{Binding ImportVideosCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Dateien importieren&#x0a;• Was es macht: Öffnet einen Dialog zur Auswahl einzelner Videodateien (MP4, MOV, AVI etc.).&#x0a;• Wozu es dient: Fügt neue Video-Clips Ihrer lokalen PB Studio Bibliothek hinzu.&#x0a;• Wann nutzen: Wann immer Sie neues Ausgangsmaterial für Ihre automatischen Schnitte bereitstellen möchten."
                            AutomationProperties.Name="Video-Dateien importieren"
                            AutomationProperties.HelpText="Importiert ausgewählte Video-Dateien in das aktive Projekt."
                            AutomationProperties.AcceleratorKey="Strg+I">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="VideoPlus" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dateien importieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding ImportFolderCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Ordner importieren&#x0a;• Was es macht: Importiert alle kompatiblen Videodateien aus einem ausgewählten Ordner auf einmal.&#x0a;• Wozu es dient: Spart Zeit beim Einlesen großer Videosammlungen.&#x0a;• Wann nutzen: Ideal zum schnellen Hinzufügen von Clip-Paketen oder B-Roll-Sammlungen." Margin="4,0,0,0"
                            AutomationProperties.Name="Video-Ordner importieren"
                            AutomationProperties.HelpText="Importiert unterstützte Video-Dateien aus einem ausgewählten Ordner."
                            AutomationProperties.AcceleratorKey="Strg+Umschalt+I">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="FolderPlus" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ordner importieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <Button Command="{Binding AnalyzeSelectedCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Ausgewählten Clip analysieren&#x0a;• Was es macht: Startet die KI-Szenen- und Bewegungserkennung für den aktuell ausgewählten Clip auf der GPU.&#x0a;• Wozu es dient: Ermittelt Schnittpunkte (Cuts) und die Dynamik (Motion) für das rhythmische Pacing.&#x0a;• Wann nutzen: Vor dem Generieren der Cut-Liste, um präzise Schnitte zu gewährleisten."
                            AutomationProperties.Name="Ausgewählten Video-Clip analysieren"
                            AutomationProperties.HelpText="Führt die aktivierten Szenen-, Bewegungs-, Embedding- und Tag-Schritte für den ausgewählten Clip aus."
                            AutomationProperties.AcceleratorKey="Strg+Eingabe">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Magnify" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <Button Command="{Binding AnalyzeAllCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Alle Clips analysieren&#x0a;• Was es macht: Analysiert die gesamte Bibliothek nacheinander vollautomatisch auf der GPU.&#x0a;• Wozu es dient: Bereitet alle importierten Videos komplett für die spätere Verwendung vor.&#x0a;• Wann nutzen: Empfohlen nach dem ersten Import einer größeren Anzahl neuer Videos (z. B. über Nacht laufen lassen)."
                            AutomationProperties.Name="Alle Video-Clips analysieren"
                            AutomationProperties.HelpText="Analysiert die gesamte Video-Bibliothek mit den aktivierten Schritten."
                            AutomationProperties.AcceleratorKey="Strg+Umschalt+Eingabe">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlaylistCheck" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Alle analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AnalyzeMarkedCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Markierte Clips analysieren&#x0a;• Was es macht: Analysiert ausschließlich die in der Übersicht selektierten Clips.&#x0a;• Wozu es dient: Ermöglicht eine gezielte Aufbereitung bestimmter Videos ohne Wartezeit für den Rest.&#x0a;• Wann nutzen: Nützlich, wenn Sie nur eine handverlesene Auswahl neu hinzugefügter Clips analysieren wollen."
                            AutomationProperties.Name="Markierte Video-Clips analysieren"
                            AutomationProperties.HelpText="Analysiert nur die als markiert gekennzeichneten Clips."
                            AutomationProperties.AccessKey="Alt+M">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Magnify" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Markierte analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <!-- Analyse-Einzelschritte Checkboxen -->
                    <CheckBox IsChecked="{Binding StepDetectScenes}"
                              Style="{StaticResource AbletonCheckBox}"
                              Content="Szenen"
                              ToolTip="Szenenerkennung&#x0a;• Was es macht: Sucht automatisch nach harten Schnitten im Video.&#x0a;• Wozu es dient: Unterteilt den Clip in Szenen, damit Schnitte rhythmisch darauf abgestimmt werden können.&#x0a;• Wann nutzen: Immer empfohlen für szenisch abwechslungsreiche Videos."/>
                     
                    <CheckBox IsChecked="{Binding StepAnalyzeMotion}"
                              Style="{StaticResource AbletonCheckBox}"
                              Content="Bewegung (RAFT)"
                              ToolTip="Bewegungsanalyse (RAFT)&#x0a;• Was es macht: Analysiert die Bewegungsdynamik (Kamera- und Objektbewegung) auf der GPU.&#x0a;• Wozu es dient: Erlaubt dem Director, schnelle Szenen mit schneller Musik und ruhige mit ruhiger Musik zu paaren.&#x0a;• Wann nutzen: Nützlich für energetische, actionreiche Musikvideos."
                              Margin="8,0,0,0"/>

                    <CheckBox IsChecked="{Binding StepGenerateEmbeddings}"
                              Style="{StaticResource AbletonCheckBox}"
                              Content="Bild-Inferenz (SigLIP)"
                              ToolTip="Semantische Bild-Inferenz (SigLIP)&#x0a;• Was es macht: Erstellt mathematische Vektoren des Videoinhalts auf der GPU.&#x0a;• Wozu es dient: Ermöglicht dem Director, thematisch exakt passende Videos zu Liedtexten oder Stimmungen zu finden.&#x0a;• Wann nutzen: Unverzichtbar für thematische und semantische Bild-Musik-Harmonie."
                              Margin="8,0,0,0"/>

                    <CheckBox IsChecked="{Binding StepGenerateCaptions}"
                              Style="{StaticResource AbletonCheckBox}"
                              Content="Tags &amp; Farben (Moondream)"
                              ToolTip="Kategorie-Tags &amp; Farben (Moondream/LM Studio)&#x0a;• Was es macht: Extrahiert dominante Farben und beschreibende Tags aus den Bildern des Clips.&#x0a;• Wozu es dient: Erlaubt Farb-Matching (z.B. dunkle Clips in ruhigen Passagen) und inhaltsbasierte Suche.&#x0a;• Wann nutzen: Aktivieren, wenn Sie exakte Stichwort- oder Farb-Suchen nutzen wollen."
                              Margin="8,0,0,0"/>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>
                     
                    <Button Command="{Binding SelectAllVideosCommand}" Style="{StaticResource ToolbarBtn}"
                            Content="_Alle markieren"
                            AutomationProperties.Name="Alle Video-Clips markieren"
                            AutomationProperties.AcceleratorKey="Strg+A"/>

                    <!-- Audit 2026-08-05 (H-1/T3b.2): IsDeleting und IsLoadingClips
                         hatten kein XAML-Element. Laufende Batch-Loeschungen und
                         das initiale Laden der Bibliothek waren fuer den User
                         unsichtbar. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"
                                Visibility="{Binding IsDeleting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <icon:PackIconMaterial Kind="Loading" Width="14" Height="14"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{StaticResource AbletonAccent}"/>
                        <TextBlock Text="Loesche..." VerticalAlignment="Center"
                                   Foreground="{StaticResource AbletonAccent}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"
                                Visibility="{Binding IsLoadingClips, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <icon:PackIconMaterial Kind="Loading" Width="14" Height="14"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{StaticResource AbletonAccent}"/>
                        <TextBlock Text="Lade Bibliothek..." VerticalAlignment="Center"
                                   Foreground="{StaticResource AbletonAccent}"/>
                    </StackPanel>

                    <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Markierte Clips löschen&#x0a;• Was es macht: Entfernt die ausgewählten Videos vollständig aus der Datenbank und dem Zwischenspeicher.&#x0a;• Wozu es dient: Bereinigt die Bibliothek von unerwünschtem Material. Die Originaldateien auf der Festplatte werden nicht gelöscht.&#x0a;• Wann nutzen: Zum Aussortieren unpassender Videos aus Ihrem PB Studio Projekt."
                            AutomationProperties.Name="Markierte Video-Clips löschen"
                            AutomationProperties.HelpText="Entfernt markierte Clips aus Projekt und Cache; Originaldateien bleiben erhalten."
                            AutomationProperties.AcceleratorKey="Entfernen">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Markierte loeschen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteAllVideosCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Gesamte Bibliothek löschen&#x0a;• Was es macht: Löscht die gesamte Videodatenbank dieses Projekts unwiderruflich.&#x0a;• Wozu es dient: Setzt das Projekt komplett zurück, um z. B. mit völlig neuem Material von vorne zu beginnen.&#x0a;• Wann nutzen: Mit Vorsicht nutzen, wenn Sie die Bibliothek vollständig leeren möchten."
                            AutomationProperties.Name="Alle Video-Clips löschen"
                            AutomationProperties.HelpText="Leert die Video-Bibliothek des aktiven Projekts vollständig; Originaldateien bleiben erhalten."
                            AutomationProperties.AcceleratorKey="Strg+Umschalt+Entfernen">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweep" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AbletonRed}"/>
                            <TextBlock Text="Alle loeschen" VerticalAlignment="Center"
                                       Foreground="{StaticResource AbletonRed}"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                </WrapPanel>

                <!-- Status and progress wrap independently below the action controls. -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="6,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource AbletonGreen}" FontSize="11">
                            <Run Text="✓ "/><Run Text="{Binding AnalyzedCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{StaticResource AbletonTextDim}" FontSize="11">
                            <Run Text="Offen: "/><Run Text="{Binding PendingCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Thumbnail loading indicator -->
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                Visibility="{Binding IsLoadingThumbnails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                     Foreground="{StaticResource AbletonAccent}"
                                     Background="{StaticResource AbletonBorder}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thumbnails…" FontSize="11"
                                   Foreground="{StaticResource AbletonTextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── Thumbnail Grid (Multi-Select) ── -->
        <ListBox x:Name="VideoClipList"
                 Grid.Row="1" Grid.Column="0" ItemsSource="{Binding VideoClips}"
                 SelectedItem="{Binding SelectedClip}"
                 SelectionMode="Extended"
                 SelectionChanged="VideoClipList_SelectionChanged"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Margin="0,0,12,0"
                 AutomationProperties.Name="Video-Clip-Liste"
                 AutomationProperties.HelpText="Mehrfachauswahl mit Umschalt- oder Strg-Taste; Entfernen löscht markierte Clips aus dem Projekt.">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource VideoThumbCard}">
                        <StackPanel>
                            <Border Height="112" CornerRadius="2,2,0,0" ClipToBounds="True">
                                <Grid>
                                    <Border Background="#2A2A2A"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <icon:PackIconMaterial Kind="Video" Width="28" Height="28"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#444"
                                                           Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                    <!-- L-N3: CACHED-Badge (top-right). Zeigt dass das Video gehasht wurde
                                         und ein Embedding aus dem Cache wiederverwendbar ist. -->
                                    <Border Background="{StaticResource AbletonAccent}"
                                            CornerRadius="2"
                                            Padding="3,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,4,4,0"
                                            Visibility="{Binding HasCacheHash, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="Analyse-Cache verfügbar&#x0a;• Was es macht: Zeigt an, dass dieses Video bereits früher gehasht und erfolgreich analysiert wurde.&#x0a;• Wozu es dient: Überspringt die langwierige GPU-Analyse und lädt die Daten in Millisekunden aus dem Cache.&#x0a;• Wann nutzen: Wird vollautomatisch verwendet, wenn Sie ein bereits bekanntes Video erneut importieren.">
                                        <TextBlock Text="CACHED" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource AbletonBg}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Feature-3: STATUS-STRIP ueber Card (Top) - IMMER sichtbar.
                                 GRUEN+CHECK = analysiert, GELB+CLOCK = offen. -->
                            <Border DockPanel.Dock="Top" Padding="6,3" CornerRadius="2,2,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FF87C96B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnalysisStatus}" Value="unavailable">
                                                <Setter Property="Background" Value="#FFE5C07B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnalysisStatus}" Value="partial">
                                                <Setter Property="Background" Value="#FFD19A4A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnalysisStatus}" Value="failed">
                                                <Setter Property="Background" Value="#FFD45D5D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnalysisStatus}" Value="interrupted">
                                                <Setter Property="Background" Value="#FFD19A4A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <icon:PackIconMaterial Width="14" Height="14"
                                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Foreground="Black">
                                        <icon:PackIconMaterial.Style>
                                            <Style TargetType="icon:PackIconMaterial">
                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAnalyzed}" Value="False">
                                                        <Setter Property="Kind" Value="ClockOutline"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </icon:PackIconMaterial.Style>
                                    </icon:PackIconMaterial>
                                    <TextBlock Text="{Binding AnalysisStatusText}"
                                               ToolTip="{Binding AnalysisDetail}"
                                               FontSize="11" FontWeight="Bold" Foreground="Black"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="8,6,8,8">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding IsMarked, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              ToolTip="Video auswählen&#x0a;• Was es macht: Markiert dieses Video für Sammelaktionen.&#x0a;• Wozu es dient: Ermöglicht es, mehrere Videos auf einmal zu analysieren oder zu löschen.&#x0a;• Wann nutzen: Zur gezielten Batch-Verarbeitung ausgewählter Videos."/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource AbletonText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding DurationText}"
                                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                                    <TextBlock Text="  |  "
                                               Foreground="{StaticResource AbletonBorder}" FontSize="11"/>
                                    <TextBlock Text="{Binding ResolutionText}"
                                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Details Panel / Scene Inspector ── -->
        <md:Card Grid.Row="1" Grid.Column="1" Style="{StaticResource AbletonCard}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CLIP DETAILS" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                
                <StackPanel DockPanel.Dock="Top" Visibility="{Binding SelectedClip, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedClip.Name}" Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedClip.AnalysisDetail}"
                               Foreground="{StaticResource AbletonTextDim}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="DAUER" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                            <TextBlock Text="{Binding SelectedClip.DurationText}" Foreground="{StaticResource AbletonText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="FPS" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                            <TextBlock Text="{Binding SelectedClip.Fps, StringFormat={}{0:F2}}" Foreground="{StaticResource AbletonText}"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- L-M4: MOTION-Card. Zeigt avg/peak/category aus video_router.list_clips
                         (Backend: app_state.video_analysis_cache[clip].motion).
                         AvgMotion null = noch nicht analysiert -> "Keine Motion-Daten" Fallback. -->
                    <Border Background="{StaticResource AbletonPanel}" BorderBrush="{StaticResource AbletonBorder}"
                            BorderThickness="1" CornerRadius="3" Margin="0,12,0,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="MOTION" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <Grid Visibility="{Binding SelectedClip.AvgMotion, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DURCHSCHNITT" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedClip.AvgMotion, StringFormat={}{0:F1}}"
                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource AbletonText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PEAK" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedClip.PeakMotion, StringFormat={}{0:F1}, FallbackValue=—, TargetNullValue=—}"
                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource AbletonText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="KATEGORIE" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                                    <TextBlock Text="{Binding SelectedClip.MotionCategoryDisplay, FallbackValue=N/A, TargetNullValue=N/A}"
                                               FontSize="13" FontWeight="Bold" Foreground="{StaticResource AbletonAccent}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Keine Motion-Daten (Clip nicht analysiert)"
                                       Visibility="{Binding SelectedClip.AvgMotion, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                       FontSize="11" Foreground="{StaticResource AbletonTextDim}" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- KI-Komponenten Analysestatus -->
                    <Border Background="{StaticResource AbletonPanel}" BorderBrush="{StaticResource AbletonBorder}"
                            BorderThickness="1" CornerRadius="3" Margin="0,10,0,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="KI-ANALYSE STATUS" FontSize="9" Foreground="{StaticResource AbletonTextDim}" Margin="0,0,0,8"/>
                            
                            <!-- Szenen (PySceneDetect) -->
                            <DockPanel Margin="0,2">
                                <icon:PackIconMaterial Kind="MovieOutline" Width="13" Height="13" Foreground="{StaticResource AbletonTextDim}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Szenen-Schnitte (PySceneDetect)" FontSize="11" Foreground="{StaticResource AbletonText}" VerticalAlignment="Center"/>
                                <icon:PackIconMaterial DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Width="12" Height="12">
                                    <icon:PackIconMaterial.Style>
                                        <Style TargetType="icon:PackIconMaterial">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AbletonGreen}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClip.IsAnalyzed}" Value="False">
                                                    <Setter Property="Kind" Value="ClockOutline"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icon:PackIconMaterial.Style>
                                </icon:PackIconMaterial>
                            </DockPanel>

                            <!-- Bewegung (RAFT) -->
                            <DockPanel Margin="0,2">
                                <icon:PackIconMaterial Kind="RunFast" Width="13" Height="13" Foreground="{StaticResource AbletonTextDim}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Bewegungskurve (RAFT)" FontSize="11" Foreground="{StaticResource AbletonText}" VerticalAlignment="Center"/>
                                <icon:PackIconMaterial DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Width="12" Height="12">
                                    <icon:PackIconMaterial.Style>
                                        <Style TargetType="icon:PackIconMaterial">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AbletonGreen}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClip.AvgMotion}" Value="{x:Null}">
                                                    <Setter Property="Kind" Value="ClockOutline"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icon:PackIconMaterial.Style>
                                </icon:PackIconMaterial>
                            </DockPanel>

                            <!-- Embeddings (SigLIP) -->
                            <DockPanel Margin="0,2">
                                <icon:PackIconMaterial Kind="VectorSquare" Width="13" Height="13" Foreground="{StaticResource AbletonTextDim}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Inhalt-Vektor (SigLIP)" FontSize="11" Foreground="{StaticResource AbletonText}" VerticalAlignment="Center"/>
                                <icon:PackIconMaterial DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Width="12" Height="12">
                                    <icon:PackIconMaterial.Style>
                                        <Style TargetType="icon:PackIconMaterial">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AbletonGreen}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClip.HasEmbedding}" Value="False">
                                                    <Setter Property="Kind" Value="ClockOutline"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AbletonTextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icon:PackIconMaterial.Style>
                                </icon:PackIconMaterial>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Modell-Anzeige für die Tags/Captions -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding SelectedClip.TagSource, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="VERWENDETES KI-MODELL" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <icon:PackIconMaterial Kind="RobotOutline" Width="13" Height="13" Foreground="{StaticResource AbletonAccent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SelectedClip.TagSource}" Foreground="{StaticResource AbletonAccent}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- KI-Tags (Moondream) -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="KI-GENERIERTE MERKMALE &amp; TAGS" FontSize="9" Foreground="{StaticResource AbletonTextDim}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedClip.Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="0,-3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AbletonPanel}" BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,3,6,3">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource AbletonText}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
 
                    <Separator Background="{StaticResource AbletonBorder}" Margin="0,12"/>
                </StackPanel>

                <!-- Scene List -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="SCENE ANALYSIS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" VerticalAlignment="Top" 
                                 Visibility="{Binding IsLoadingScenes, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedClipScenes}" 
                             Background="Transparent" BorderThickness="0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Szenen des ausgewählten Video-Clips"
                             AutomationProperties.HelpText="Liste erkannter Szenen mit Zeitbereich und Erkennungs-Konfidenz.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AbletonPanel}" Margin="0,0,0,4" Padding="8,6" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding SceneIndex}" Foreground="{StaticResource AbletonTextDim}" FontWeight="Bold"/>
                                        
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Foreground="{StaticResource AbletonText}" FontSize="11">
                                                <Run Text="{Binding StartTime, StringFormat={}{0:F2}s}"/> 
                                                <Run Text=" - "/> 
                                                <Run Text="{Binding EndTime, StringFormat={}{0:F2}s}"/>
                                            </TextBlock>
                                            <!-- AP3.3 (Audit 2026-06-10): MotionScore existiert pro Szene nicht
                                                 (Backend liefert Motion nur pro Clip) — Balken+Wert zeigen jetzt
                                                 die real vorhandene Scene-Detection-Confidence (0-1). -->
                                            <Grid Margin="0,4,0,0" Height="4" Background="{StaticResource AbletonBorder}">
                                                <Rectangle HorizontalAlignment="Left" Fill="{StaticResource AbletonAccent}" Opacity="0.8">
                                                    <Rectangle.Width>
                                                        <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                            <Binding Path="Confidence"/>
                                                            <Binding Source="{StaticResource SceneBarScale}"/>
                                                        </MultiBinding>
                                                    </Rectangle.Width>
                                                </Rectangle>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Confidence, StringFormat={}{0:F2}}"
                                                   Foreground="{StaticResource AbletonAccent}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </md:Card>

        <!-- ── Status-Bereich: Bars BREIT (full row), darunter Step + Status -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1"
                CornerRadius="2" Padding="12,10" Margin="0,12,0,0">
            <StackPanel>
                <!-- Import-Progress (full-width) -->
                <controls:ProgressBarWithLabel
                    Percent="{Binding ImportProgress}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <!-- Batch-Analyse-Progress (full-width) -->
                <controls:ProgressBarWithLabel
                    Percent="{Binding AnalyzeAllProgress}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    Visibility="{Binding IsAnalyzingAll, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <!-- Per-Clip Analyse-Progress (full-width) -->
                <controls:ProgressBarWithLabel
                    Percent="{Binding CurrentClipProgress}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <!-- Step-Indicator -->
                <StackPanel Orientation="Horizontal" Margin="2,4,0,0"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Schritt " Foreground="{StaticResource AbletonTextDim}" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentStepIndex}" Foreground="{StaticResource AbletonAccent}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="/" Foreground="{StaticResource AbletonTextDim}" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentStepTotal}" Foreground="{StaticResource AbletonTextDim}" FontSize="12"/>
                    <TextBlock Text=": " Foreground="{StaticResource AbletonTextDim}" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentStep}" Foreground="{StaticResource AbletonText}" FontSize="12" FontStyle="Italic"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AbletonTextDim}"
                           FontSize="12" Margin="2,4,0,0"
                           AutomationProperties.Name="{Binding StatusText}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
