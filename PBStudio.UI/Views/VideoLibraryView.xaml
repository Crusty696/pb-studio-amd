<UserControl x:Class="PBStudio.UI.Views.VideoLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             xmlns:models="clr-namespace:PBStudio.UI.Models"
             xmlns:converters="clr-namespace:PBStudio.UI.Converters"
             xmlns:controls="clr-namespace:PBStudio.UI.Controls"
             Background="{StaticResource AbletonBg}">

    <UserControl.Resources>
        <converters:TimeToPixelConverter x:Key="TimeToPixelConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource AbletonToolbar}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ImportVideosCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Einzelne Video-Dateien importieren">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="VideoPlus" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dateien importieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding ImportFolderCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Ganzen Ordner importieren" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="FolderPlus" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ordner importieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <Button Command="{Binding AnalyzeSelectedCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Selektierten Clip analysieren (Scene-Detection + Motion)">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Magnify" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <Button Command="{Binding AnalyzeAllCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Alle Clips analysieren (Scene-Detection + Motion) – dauert länger">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlaylistCheck" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Alle analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AnalyzeMarkedCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Nur die markierten Clips analysieren">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Magnify" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Markierte analysieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <Button Command="{Binding SelectAllVideosCommand}" Style="{StaticResource ToolbarBtn}"
                            Content="Alle markieren"/>

                    <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="Markierte Clips loeschen (DB + Memory + Analyse-Cache)">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Markierte loeschen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteAllVideosCommand}" Style="{StaticResource ToolbarBtn}"
                            ToolTip="ALLE Video-Clips loeschen">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweep" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AbletonRed}"/>
                            <TextBlock Text="Alle loeschen" VerticalAlignment="Center"
                                       Foreground="{StaticResource AbletonRed}"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource AbletonBorder}" Margin="4,6"/>

                    <!-- Analysed-counts indicator -->
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{StaticResource AbletonGreen}" FontSize="11">
                        <Run Text="✓ "/><Run Text="{Binding AnalyzedCount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{StaticResource AbletonTextDim}" FontSize="11">
                        <Run Text="Offen: "/><Run Text="{Binding PendingCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Thumbnail loading indicator -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsLoadingThumbnails, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                 Foreground="{StaticResource AbletonAccent}"
                                 Background="{StaticResource AbletonBorder}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Thumbnails…" FontSize="11"
                               Foreground="{StaticResource AbletonTextDim}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Thumbnail Grid (Multi-Select) ── -->
        <ListBox x:Name="VideoClipList"
                 Grid.Row="1" Grid.Column="0" ItemsSource="{Binding VideoClips}"
                 SelectedItem="{Binding SelectedClip}"
                 SelectionMode="Extended"
                 SelectionChanged="VideoClipList_SelectionChanged"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Margin="0,0,12,0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource VideoThumbCard}">
                        <StackPanel>
                            <Border Height="112" CornerRadius="2,2,0,0" ClipToBounds="True">
                                <Grid>
                                    <Border Background="#2A2A2A"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <icon:PackIconMaterial Kind="Video" Width="28" Height="28"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#444"
                                                           Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="8,6,8,8">
                                <DockPanel>
                                    <!-- Feature-3: IsAnalyzed-Badge -->
                                    <icon:PackIconMaterial DockPanel.Dock="Right"
                                                           Kind="CheckCircle" Width="11" Height="11"
                                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource AbletonGreen}"
                                                           ToolTip="Bereits analysiert"
                                                           Visibility="{Binding IsAnalyzed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource AbletonText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding DurationText}"
                                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                                    <TextBlock Text="  |  "
                                               Foreground="{StaticResource AbletonBorder}" FontSize="11"/>
                                    <TextBlock Text="{Binding ResolutionText}"
                                               Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Details Panel / Scene Inspector ── -->
        <md:Card Grid.Row="1" Grid.Column="1" Style="{StaticResource AbletonCard}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CLIP DETAILS" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                
                <StackPanel DockPanel.Dock="Top" Visibility="{Binding SelectedClip, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedClip.Name}" Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="DAUER" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                            <TextBlock Text="{Binding SelectedClip.DurationText}" Foreground="{StaticResource AbletonText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="FPS" FontSize="9" Foreground="{StaticResource AbletonTextDim}"/>
                            <TextBlock Text="{Binding SelectedClip.Fps, StringFormat={}{0:F2}}" Foreground="{StaticResource AbletonText}"/>
                        </StackPanel>
                    </UniformGrid>
                    <Separator Background="{StaticResource AbletonBorder}" Margin="0,12"/>
                </StackPanel>

                <!-- Scene List -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="SCENE ANALYSIS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" VerticalAlignment="Top" 
                                 Visibility="{Binding IsLoadingScenes, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedClipScenes}" 
                             Background="Transparent" BorderThickness="0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AbletonPanel}" Margin="0,0,0,4" Padding="8,6" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding SceneIndex}" Foreground="{StaticResource AbletonTextDim}" FontWeight="Bold"/>
                                        
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Foreground="{StaticResource AbletonText}" FontSize="11">
                                                <Run Text="{Binding StartTime, StringFormat={}{0:F2}s}"/> 
                                                <Run Text=" - "/> 
                                                <Run Text="{Binding EndTime, StringFormat={}{0:F2}s}"/>
                                            </TextBlock>
                                            <Grid Margin="0,4,0,0" Height="4" Background="{StaticResource AbletonBorder}">
                                                <Rectangle HorizontalAlignment="Left" Fill="{StaticResource AbletonAccent}" Opacity="0.8">
                                                    <Rectangle.Width>
                                                        <MultiBinding Converter="{StaticResource TimeToPixelConverter}">
                                                            <Binding Path="MotionScore"/>
                                                            <Binding Source="100.0"/> <!-- scale 0-1 to 100px -->
                                                        </MultiBinding>
                                                    </Rectangle.Width>
                                                </Rectangle>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding MotionScore, StringFormat={}{0:F1}}" 
                                                   Foreground="{StaticResource AbletonAccent}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </md:Card>

        <!-- ── Status Bar mit Step-Indicator + ProgressBarWithLabel (Feature-1+3) ── -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}" BorderThickness="1"
                CornerRadius="2" Padding="10,6" Margin="0,12,0,0">
            <DockPanel>
                <!-- Batch-Progress (alle markierten/alle Clips) -->
                <controls:ProgressBarWithLabel DockPanel.Dock="Left" Width="180"
                                               Percent="{Binding AnalyzeAllProgress}"
                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsAnalyzingAll, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <!-- Per-Clip Progress (current step within current clip) -->
                <controls:ProgressBarWithLabel DockPanel.Dock="Left" Width="160"
                                               Percent="{Binding CurrentClipProgress}"
                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <!-- Step-Indicator (Feature-3) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Schritt " Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentStepIndex}" Foreground="{StaticResource AbletonAccent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="/" Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentStepTotal}" Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                    <TextBlock Text=": " Foreground="{StaticResource AbletonTextDim}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentStep}" Foreground="{StaticResource AbletonText}" FontSize="11" FontStyle="Italic"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AbletonTextDim}"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
