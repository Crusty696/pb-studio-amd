<UserControl x:Class="PBStudio.UI.Views.VramTelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PBStudio.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:VramTelemetryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AbletonBg}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             AutomationProperties.Name="VRAM-Telemetrie"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header / Summary Bar ══ -->
        <Border Grid.Row="0"
                Background="{StaticResource AbletonPanel}"
                BorderBrush="{StaticResource AbletonBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource AbletonTextDim}"
                               Margin="0,0,12,0"
                               Visibility="{Binding LastFetchedAt, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Letzter Refresh: "/><Run Text="{Binding LastFetchedAt, StringFormat=HH:mm:ss, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource AbletonAccent}"
                            Padding="6,4" Height="28"
                            ToolTip="Telemetrie aktualisieren&#x0a;• Was es macht: Lädt die aktuellen VRAM-Belegungsdaten und die GPU-Telemetrie sofort neu.&#x0a;• Wozu es dient: Zeigt dir an, ob Modelle im VRAM verblieben sind, wie viel Speicher gerade aktiv genutzt wird und ob Fehler auftraten.&#x0a;• Wann &amp; wie nutzen: Nach Analysevorgängen oder dem Laden neuer Modelle anklicken, um die VRAM-Auslastung live zu kontrollieren."
                            AutomationProperties.Name="VRAM-Telemetrie aktualisieren"
                            AutomationProperties.HelpText="Lädt GPU-Budget, Modellbelegung, Laufzeiten und Fehlerstatus neu."
                            AutomationProperties.AcceleratorKey="F5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Refresh" Width="14" Height="14"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="VRAM TELEMETRIE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource AbletonTextDim}"
                               FontSize="11" Margin="0,2,0,0"
                               AutomationProperties.Name="{Binding StatusText}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Cards-Liste ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12">

                <!-- ══ Budget-Card (VRAMBudgetManager.get_stats) ══ -->
                <md:Card Style="{StaticResource AbletonCard}"
                         Padding="14"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasBudget, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="VRAM BUDGET"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AbletonAccent}"
                                       VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource AbletonTextDim}">
                                <Run Text="committed "/><Run Text="{Binding BudgetUsedPercent, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                <Run Text=" · loaded "/><Run Text="{Binding BudgetLoadedModels, Mode=OneWay}"/>
                                <Run Text=" · reserved "/><Run Text="{Binding BudgetReservedModels, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MAX (MB)" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BudgetMaxMb}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AbletonText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="USABLE" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BudgetUsableMb}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AbletonText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SAFETY" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BudgetSafetyMb}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AbletonTextDim}"
                                           ToolTip="Sicherheits-Reserve (Safety)&#x0a;• Was es macht: Speichert einen festen Puffer deines Grafikkartenspeichers (VRAM) für Windows und andere Apps ab.&#x0a;• Wozu es dient: Verhindert Abstürze (Out-of-Memory-Fehler), da das System und die Anzeige stets genügend freien VRAM behalten.&#x0a;• Wann &amp; wie nutzen: Wird automatisch berechnet. Du musst hier nichts tun; der Wert schützt dein System im Hintergrund."/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="RESERVED" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BudgetReservedMb}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AbletonYellow}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="COMMITTED" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BudgetCommittedMb}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AbletonGreen}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="HEADROOM" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BudgetAvailableMb}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AbletonAccent}"
                                           ToolTip="Freier Modell-VRAM (Headroom)&#x0a;• Was es macht: Zeigt den VRAM an, der für weitere KI-Modelle innerhalb des erlaubten Limits noch zur Verfügung steht.&#x0a;• Wozu es dient: Zeigt dir auf einen Blick, ob du ein weiteres Modell (z.B. Phi-3 oder Moondream) starten kannst, ohne die Sicherheits-Reserve zu verletzen.&#x0a;• Wann &amp; wie nutzen: Vor dem Starten neuer KI-Tasks prüfen. Liegt der Headroom nahe 0 MB, sollten andere Modelle im Model-Manager zuerst entladen werden."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </md:Card>

                <!-- Empty-State -->
                <TextBlock Text="Noch keine GPU-Tasks beobachtet. Sobald ein Modell läuft, erscheint hier eine Karte."
                           Foreground="{StaticResource AbletonTextDim}"
                           FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,40,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModelsTracked}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Models}"
                              AutomationProperties.Name="VRAM-Modellbelegung">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VramTelemetryModelCardViewModel}">
                            <md:Card Style="{StaticResource AbletonCard}"
                                     Padding="14"
                                     Margin="0,0,12,12"
                                     Width="420">
                                <StackPanel>
                                    <!-- Model Header -->
                                    <!-- T5c (S-H1b 2026-05-19): LastObservedText entfernt — Backend liefert kein last_observed_at mehr. -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ModelId}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AbletonAccent}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Counters -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="OBSERV." Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding Count}" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AbletonText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="OK" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding SuccessCount}" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AbletonGreen}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="FEHLER" Style="{StaticResource ParamLabel}"/>
                                            <TextBlock Text="{Binding FailureCount}" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AbletonYellow}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Duration block -->
                                    <TextBlock Text="DAUER (ms)" Style="{StaticResource ParamLabel}"/>
                                    <TextBlock Text="{Binding DurationSummary}"
                                               Foreground="{StaticResource AbletonText}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding DurationHistogram}" Margin="0,0,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:VramHistogramBar}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AbletonTextDim}"
                                                               VerticalAlignment="Center"/>
                                                    <Rectangle Grid.Column="1"
                                                               Height="10"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Width="{Binding BarWidth}"
                                                               Fill="{StaticResource AbletonAccent}"
                                                               RadiusX="2" RadiusY="2"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Count}"
                                                               FontSize="10"
                                                               TextAlignment="Right"
                                                               Foreground="{StaticResource AbletonText}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- VRAM block -->
                                    <TextBlock Text="VRAM PEAK (MB)" Style="{StaticResource ParamLabel}"/>
                                    <TextBlock Text="{Binding VramSummary}"
                                               Foreground="{StaticResource AbletonText}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding VramHistogram}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:VramHistogramBar}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AbletonTextDim}"
                                                               VerticalAlignment="Center"/>
                                                    <Rectangle Grid.Column="1"
                                                               Height="10"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Width="{Binding BarWidth}"
                                                               Fill="{StaticResource AbletonGreen}"
                                                               RadiusX="2" RadiusY="2"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Count}"
                                                               FontSize="10"
                                                               TextAlignment="Right"
                                                               Foreground="{StaticResource AbletonText}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Last error block (rot, nur sichtbar wenn vorhanden) -->
                                    <Border Margin="0,10,0,0"
                                            Padding="8,6"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource AbletonRed}"
                                            CornerRadius="3"
                                            Background="#22FF4444"
                                            Visibility="{Binding LastErrorText, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <icon:PackIconMaterial Kind="AlertCircle"
                                                                   Width="14" Height="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="{StaticResource AbletonRed}"/>
                                            <TextBlock Text="{Binding LastErrorText}"
                                                       Foreground="{StaticResource AbletonRed}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
