{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pb-studio.local/schemas/obj77-migration-approval-v1.json",
  "title": "OBJ77 migration approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "bundle_id",
    "scope",
    "target_kind",
    "target_path",
    "source_sha256",
    "source_bundle_sha256",
    "source_schema_version",
    "target_schema_version",
    "project_uuid",
    "backup_path",
    "backup_sha256",
    "backup_bundle_sha256",
    "rollback_command",
    "approved",
    "approved_at_utc",
    "approval_source"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "format": "uuid"},
    "bundle_id": {"type": "string", "format": "uuid"},
    "scope": {"enum": ["fixture", "real"]},
    "target_kind": {"enum": ["embeddings", "catalog"]},
    "target_path": {"type": "string", "minLength": 3},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_schema_version": {"type": "integer", "minimum": 0},
    "target_schema_version": {"type": "integer", "minimum": 1},
    "project_uuid": {"type": ["string", "null"], "format": "uuid"},
    "backup_path": {"type": "string", "minLength": 3},
    "backup_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backup_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rollback_command": {"type": "string", "minLength": 10},
    "approved": {"const": true},
    "approved_at_utc": {"type": "string", "format": "date-time"},
    "approval_source": {"type": "string", "minLength": 3}
  }
}
